<UserControl x:Class="EEGMonitor.AnesthesiaSleep.Views.Controls.PositionTrackingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPanelBrush}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 体位控制 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
            <StackPanel>
                <TextBlock Text="体位记录" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="当前体位" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding CurrentPositionLabel}" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource GreenOkBrush}" Margin="0,4,0,10"/>

                <TextBlock Text="记录体位变更" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                <WrapPanel>
                    <Button Content="仰卧" Command="{Binding SetPositionCommand}" CommandParameter="Supine"
                            Style="{StaticResource ActionButtonStyle}" Width="84" Height="36" Margin="0,0,4,4"/>
                    <Button Content="俯卧" Command="{Binding SetPositionCommand}" CommandParameter="Prone"
                            Style="{StaticResource ActionButtonStyle}" Width="84" Height="36" Margin="0,0,4,4"/>
                    <Button Content="左侧卧" Command="{Binding SetPositionCommand}" CommandParameter="LeftLateral"
                            Style="{StaticResource ActionButtonStyle}" Width="84" Height="36" Margin="0,0,4,4"/>
                    <Button Content="右侧卧" Command="{Binding SetPositionCommand}" CommandParameter="RightLateral"
                            Style="{StaticResource ActionButtonStyle}" Width="84" Height="36" Margin="0,0,4,4"/>
                    <Button Content="坐位" Command="{Binding SetPositionCommand}" CommandParameter="Sitting"
                            Style="{StaticResource ActionButtonStyle}" Width="84" Height="36" Margin="0,0,4,4"/>
                    <Button Content="站立" Command="{Binding SetPositionCommand}" CommandParameter="Standing"
                            Style="{StaticResource ActionButtonStyle}" Width="84" Height="36" Margin="0,0,4,4"/>
                </WrapPanel>

                <TextBlock Text="备注" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,10,0,2"/>
                <TextBox Text="{Binding PositionNotes, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBoxStyle}" Height="40" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 体位变更历史 -->
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="8,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="体位变更历史" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PositionRecords}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0C1422" Padding="8,6" Margin="0,2"
                                        BorderBrush="#182C46" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Position}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Notes}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="8,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
