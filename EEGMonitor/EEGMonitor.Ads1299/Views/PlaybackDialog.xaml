<Window x:Class="Ads1299Monitor.Views.PlaybackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="数据回放" Height="780" Width="1180"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="lvc:CartesianChart"><Setter Property="Background" Value="Transparent"/></Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 会话选择 + 加载 + 摘要 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="会话:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="220" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" VerticalAlignment="Center"/>
                <Button Content="加载" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="16,6"/>
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- 全程趋势 + 游标 + 事件标记 -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="关键参数趋势(全程)" Style="{StaticResource PanelTitle}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="qCON" Foreground="#FF3B82F6" Margin="6,0"/>
                        <TextBlock Text="qNOX" Foreground="#FFF59E0B" Margin="6,0"/>
                        <TextBlock Text="SQI" Foreground="#FF22C55E" Margin="6,0"/>
                        <TextBlock Text="HR" Foreground="#FFEF4444" Margin="6,0"/>
                    </StackPanel>
                </DockPanel>
                <lvc:CartesianChart Series="{Binding TrendSeries}" XAxes="{Binding TrendXAxes}"
                                    YAxes="{Binding TrendYAxes}" Sections="{Binding TrendSections}"
                                    TooltipPosition="Hidden"/>
            </DockPanel>
        </Border>

        <!-- 当前帧读数 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,28,0"><TextBlock Text="时间" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding CurTime}" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="Bold"/></StackPanel>
                <StackPanel Margin="0,0,28,0"><TextBlock Text="qCON" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding QConText}" Foreground="#FF3B82F6" FontSize="20" FontWeight="Bold"/></StackPanel>
                <StackPanel Margin="0,0,28,0"><TextBlock Text="qNOX" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding QNoxText}" Foreground="#FFF59E0B" FontSize="20" FontWeight="Bold"/></StackPanel>
                <StackPanel Margin="0,0,28,0"><TextBlock Text="SQI" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding SqiText}" Foreground="#FF22C55E" FontSize="20" FontWeight="Bold"/></StackPanel>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="频带占比 %" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding BandText}" Foreground="{StaticResource TextBrush}" FontSize="15"/></StackPanel>
            </StackPanel>
        </Border>

        <!-- 原始EEG窗口(游标处 10s) -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="原始 EEG(游标前 10 秒)" Style="{StaticResource PanelTitle}"/>
                <lvc:CartesianChart Series="{Binding EegSeries}" XAxes="{Binding EegXAxes}" YAxes="{Binding EegYAxes}" TooltipPosition="Hidden"/>
            </DockPanel>
        </Border>

        <!-- 播放控制 -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}"
                        Style="{StaticResource StartButton}" Width="110" Height="34"/>
                <TextBlock DockPanel.Dock="Left" Text="速度" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,6,0"/>
                <ComboBox DockPanel.Dock="Left" x:Name="SpeedBox" Width="74" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="SpeedBox_Changed">
                    <ComboBoxItem Content="1x" Tag="1"/><ComboBoxItem Content="2x" Tag="2"/>
                    <ComboBoxItem Content="4x" Tag="4"/><ComboBoxItem Content="8x" Tag="8"/>
                </ComboBox>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CurTime}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Slider Minimum="0" Maximum="{Binding FrameCount}" Value="{Binding CurrentIndex, Mode=TwoWay}"
                        VerticalAlignment="Center" Margin="16,0,0,0" IsSnapToTickEnabled="True" TickFrequency="1"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
