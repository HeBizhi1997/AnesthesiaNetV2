<Application x:Class="Ads1299Monitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ── Dark theme palette ── -->
            <Color x:Key="BgColor">#FF0B0F14</Color>
            <Color x:Key="PanelColor">#FF111821</Color>
            <SolidColorBrush x:Key="BgBrush"     Color="#FF0B0F14"/>
            <SolidColorBrush x:Key="PanelBrush"  Color="#FF111821"/>
            <SolidColorBrush x:Key="PanelBorder" Color="#FF1E2A38"/>
            <SolidColorBrush x:Key="TextBrush"   Color="#FFE6EDF3"/>
            <SolidColorBrush x:Key="MutedBrush"  Color="#FF7D8B9A"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF22D3A6"/>

            <SolidColorBrush x:Key="DeltaBrush" Color="#FF8B5CF6"/>
            <SolidColorBrush x:Key="ThetaBrush" Color="#FF3B82F6"/>
            <SolidColorBrush x:Key="AlphaBrush" Color="#FF22C55E"/>
            <SolidColorBrush x:Key="BetaBrush"  Color="#FFF59E0B"/>
            <SolidColorBrush x:Key="GammaBrush" Color="#FFEF4444"/>

            <!-- ── Card panel ── -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <Style x:Key="PanelTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="2,0,0,6"/>
            </Style>

            <!-- Sidebar nav item -->
            <Style x:Key="NavItem" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="0,10">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#FF13243A"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#FF0F1A28"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Secondary (outline) button -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#FF152033" BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="14,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StartButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="#FF06231C"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="28,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
