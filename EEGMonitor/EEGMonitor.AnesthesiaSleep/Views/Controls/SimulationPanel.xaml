<UserControl x:Class="EEGMonitor.AnesthesiaSleep.Views.Controls.SimulationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPanelBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="模拟测试控制台" FontSize="14" FontWeight="Bold"
                   Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,12"/>

        <!-- 场景选择 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="临床场景" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}"
                          Style="{StaticResource DarkComboStyle}" MinWidth="300" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ScenarioNameConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 场景说明 -->
                <Border Background="#0A1220" Padding="10" Margin="0,8,0,0">
                    <TextBlock Text="{Binding SelectedScenario, Converter={StaticResource ScenarioDescConverter}}"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 控制面板 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- 模拟速度 -->
                    <TextBlock Text="模拟速度" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="1x"  Command="{Binding SetSpeedCommand}" CommandParameter="1"
                                Style="{StaticResource ActionButtonStyle}" Width="42" Height="28" Margin="0,0,4,4"/>
                        <Button Content="2x"  Command="{Binding SetSpeedCommand}" CommandParameter="2"
                                Style="{StaticResource ActionButtonStyle}" Width="42" Height="28" Margin="0,0,4,4"/>
                        <Button Content="5x"  Command="{Binding SetSpeedCommand}" CommandParameter="5"
                                Style="{StaticResource ActionButtonStyle}" Width="42" Height="28" Margin="0,0,4,4"/>
                        <Button Content="10x" Command="{Binding SetSpeedCommand}" CommandParameter="10"
                                Style="{StaticResource ActionButtonStyle}" Width="42" Height="28" Margin="0,0,4,4"/>
                        <Button Content="20x" Command="{Binding SetSpeedCommand}" CommandParameter="20"
                                Style="{StaticResource ActionButtonStyle}" Width="42" Height="28" Margin="0,0,4,4"/>
                        <Button Content="60x" Command="{Binding SetSpeedCommand}" CommandParameter="60"
                                Style="{StaticResource ActionButtonStyle}" Width="42" Height="28" Margin="0,0,4,4"/>
                    </WrapPanel>

                    <!-- 运行控制 -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶ 启动模拟" Command="{Binding StartSimulationCommand}" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                    <Setter Property="Background" Value="#0A2A14"/>
                                    <Setter Property="Foreground" Value="{StaticResource GreenOkBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource GreenOkBrush}"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="■ 停止" Command="{Binding StopSimulationCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                    <Setter Property="Background" Value="#2A0A0C"/>
                                    <Setter Property="Foreground" Value="{StaticResource RedCritBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource RedCritBrush}"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- 运行状态 -->
                <Border Grid.Column="1" Background="#0A1220" Padding="14" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="运行状态:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SimStatus}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模拟时长:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElapsedDisplay}" FontSize="14"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Consolas"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="当前速度:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SimSpeed, StringFormat={}{0}x}" FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 场景详情卡片 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 各场景预期参数表 -->
                <Border Grid.Row="0" Style="{StaticResource SectionLabelStyle}">
                    <TextBlock Text="各场景预期观测指标" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl Margin="8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <DataTemplate x:Key="CardTemplate">
                                <Border Width="200" Style="{StaticResource CardBorderStyle}" Padding="10" Margin="4">
                                    <StackPanel/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.Resources>

                        <!-- Natural Sleep -->
                        <Border Width="200" Style="{StaticResource CardBorderStyle}" Padding="10" Margin="4">
                            <StackPanel>
                                <TextBlock Text="自然睡眠" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,4"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <Run Text="• BIS: 35-95"/>
                                    <LineBreak/>
                                    <Run Text="• 4-5次 NREM-REM 周期"/>
                                    <LineBreak/>
                                    <Run Text="• N3 占比前期高(20-25%)"/>
                                    <LineBreak/>
                                    <Run Text="• REM 后期增多(20-25%)"/>
                                    <LineBreak/>
                                    <Run Text="• ODI &lt; 5"/>
                                    <LineBreak/>
                                    <Run Text="• SpO2 稳定 95-99%"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- DISE -->
                        <Border Width="200" Style="{StaticResource CardBorderStyle}" Padding="10" Margin="4">
                            <StackPanel>
                                <TextBlock Text="DISE" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,4"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <Run Text="• BIS: 30-60 (靶控)"/>
                                    <LineBreak/>
                                    <Run Text="• 丙泊酚 1.5mg/kg 推注"/>
                                    <LineBreak/>
                                    <Run Text="• 诱导 1-2min → 30min 维持"/>
                                    <LineBreak/>
                                    <Run Text="• 无 REM（药物抑制）"/>
                                    <LineBreak/>
                                    <Run Text="• SpO2 可能轻度下降"/>
                                    <LineBreak/>
                                    <Run Text="• 30min 后苏醒观察"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- OSA Screening -->
                        <Border Width="200" Style="{StaticResource CardBorderStyle}" Padding="10" Margin="4">
                            <StackPanel>
                                <TextBlock Text="OSA 筛查" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,4"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <Run Text="• SpO2 周期性下降 8-20%"/>
                                    <LineBreak/>
                                    <Run Text="• ODI₃ 15-40/hr"/>
                                    <LineBreak/>
                                    <Run Text="• ODI₄ 10-25/hr"/>
                                    <LineBreak/>
                                    <Run Text="• 最低 SpO2 75-88%"/>
                                    <LineBreak/>
                                    <Run Text="• 事件持续 20-60s"/>
                                    <LineBreak/>
                                    <Run Text="• T90 5-25%"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Conscious Sedation -->
                        <Border Width="200" Style="{StaticResource CardBorderStyle}" Padding="10" Margin="4">
                            <StackPanel>
                                <TextBlock Text="清醒镇静" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,4"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <Run Text="• BIS: 65-85"/>
                                    <LineBreak/>
                                    <Run Text="• 咪达唑仑 2mg + 芬太尼 50mcg"/>
                                    <LineBreak/>
                                    <Run Text="• Ramsay 2-3 / MOAA/S 3-4"/>
                                    <LineBreak/>
                                    <Run Text="• 可被唤醒"/>
                                    <LineBreak/>
                                    <Run Text="• 轻度 N1-N2 睡眠"/>
                                    <LineBreak/>
                                    <Run Text="• 约 60min 代谢恢复"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
