<Window x:Class="NSMMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="NSM 麻醉深度监护系统" Height="960" Width="1600"
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei, Segoe UI">

    <DockPanel>

        <!-- ═══════════ 顶部标题栏 ═══════════ -->
        <Border DockPanel.Dock="Top" Height="62" Background="#0C1424"
                BorderBrush="#1E2A44" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NSM" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="麻醉深度监护系统" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TitleBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="Anesthesia Depth Monitoring" FontSize="11" Foreground="{StaticResource MiniLabelBrush}"
                               VerticalAlignment="Bottom" Margin="12,0,0,5"/>
                </StackPanel>

                <!-- 右侧：两路数据源状态 + 时间 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 脑电链路 -->
                    <Border CornerRadius="13" Padding="11,4" Margin="0,0,8,0" Background="#14203A" BorderBrush="#243450" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#3D5A7A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource GreenOkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="脑电" Foreground="{StaticResource MiniLabelBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SourceName}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 血氧链路 -->
                    <Border CornerRadius="13" Padding="11,4" Margin="0,0,16,0" Background="#14203A" BorderBrush="#243450" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#3D5A7A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPpgConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource GreenOkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="血氧" Foreground="{StaticResource MiniLabelBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding PpgStatusMessage}" Foreground="{StaticResource Spo2AccentBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding CurrentTime}" FontSize="23" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             生命体征带 — 大号读数横排，手术室内远距离可读
             分三组：[CSI · SPI · 融合] 麻醉指数三联 ‖ [NOX] 设备镇痛 ‖ [SpO₂ · 脉搏] PPG 生命体征
             每格底部区间条：深色轨道 + 目标窗高亮段 + 当前值填充
             ═══════════════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Height="152" Background="{StaticResource VitalBarBrush}"
                BorderBrush="#1E2A44" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 组底色：三联指数 / PPG 生命体征各一块，让分组在视觉上先于分隔线成立 -->
                <Border Grid.Column="0" Grid.ColumnSpan="5" Background="#0D1729" CornerRadius="10" Margin="0,10"/>
                <Border Grid.Column="8" Grid.ColumnSpan="3" Background="#0D1729" CornerRadius="10" Margin="0,10"/>

                <!-- ── CSI ── -->
                <Grid Grid.Column="0" Margin="10,14,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="CSI" Style="{StaticResource VitalNameStyle}" Foreground="{StaticResource CsiAccentBrush}"/>
                        <TextBlock Text="麻醉深度 · 等效 BIS" Style="{StaticResource VitalSubStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding CsiDisplay}" Style="{StaticResource VitalValueStyle}"
                               Foreground="{Binding CsiValue, Converter={StaticResource CsiColor}}"/>
                    <TextBlock Grid.Row="2" Text="{Binding CsiZone}" Style="{StaticResource VitalZoneStyle}"
                               Foreground="{Binding CsiValue, Converter={StaticResource CsiColor}}"/>
                    <Grid Grid.Row="3" Height="7" Margin="4,9,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40*"/><ColumnDefinition Width="20*"/><ColumnDefinition Width="40*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="3" CornerRadius="3" Background="{StaticResource RangeTrackBrush}"/>
                            <Border Grid.Column="1" Background="{StaticResource RangeTargetBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding CsiValue, Converter={StaticResource RangeBar}, ConverterParameter='0,100,fill'}"/>
                                <ColumnDefinition Width="{Binding CsiValue, Converter={StaticResource RangeBar}, ConverterParameter='0,100,rest'}"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" Background="{Binding CsiValue, Converter={StaticResource CsiColor}}"/>
                        </Grid>
                    </Grid>
                </Grid>

                <Rectangle Grid.Column="1" Width="1" Fill="#1B2942" Margin="0,26"/>

                <!-- ── SPI（PPG 导出，与 CSI 并排对比）── -->
                <Grid Grid.Column="2" Margin="10,14,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="SPI" Style="{StaticResource VitalNameStyle}" Foreground="{StaticResource SpiAccentBrush}"/>
                        <TextBlock Text="伤害感受 · 手术容积脉搏波" Style="{StaticResource VitalSubStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding SpiDisplay}" Style="{StaticResource VitalValueStyle}"
                               Foreground="{Binding SpiValue, Converter={StaticResource SpiColor}}"/>
                    <TextBlock Grid.Row="2" Text="{Binding SpiZone}" Style="{StaticResource VitalZoneStyle}"
                               Foreground="{Binding SpiValue, Converter={StaticResource SpiColor}}"/>
                    <Grid Grid.Row="3" Height="7" Margin="4,9,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20*"/><ColumnDefinition Width="30*"/><ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="3" CornerRadius="3" Background="{StaticResource RangeTrackBrush}"/>
                            <Border Grid.Column="1" Background="{StaticResource RangeTargetBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding SpiValue, Converter={StaticResource RangeBar}, ConverterParameter='0,100,fill'}"/>
                                <ColumnDefinition Width="{Binding SpiValue, Converter={StaticResource RangeBar}, ConverterParameter='0,100,rest'}"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" Background="{Binding SpiValue, Converter={StaticResource SpiColor}}"/>
                        </Grid>
                    </Grid>
                </Grid>

                <Rectangle Grid.Column="3" Width="1" Fill="#1B2942" Margin="0,26"/>

                <!-- ── 融合指数 CSI ⊕ SPI（权重来自配置文件）── -->
                <Grid Grid.Column="4" Margin="10,14,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="融合指数" Style="{StaticResource VitalNameStyle}" Foreground="{StaticResource FusionAccentBrush}"/>
                        <TextBlock Text="{Binding FusionWeightLabel}" Style="{StaticResource VitalSubStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding FusionDisplay}" Style="{StaticResource VitalValueStyle}"
                               Foreground="{Binding FusionValue, Converter={StaticResource CsiColor}}"/>
                    <TextBlock Grid.Row="2" Text="{Binding FusionZone}" Style="{StaticResource VitalZoneStyle}"
                               Foreground="{Binding FusionValue, Converter={StaticResource CsiColor}}"/>
                    <Grid Grid.Row="3" Height="7" Margin="4,9,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40*"/><ColumnDefinition Width="20*"/><ColumnDefinition Width="40*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="3" CornerRadius="3" Background="{StaticResource RangeTrackBrush}"/>
                            <Border Grid.Column="1" Background="{StaticResource RangeTargetBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding FusionValue, Converter={StaticResource RangeBar}, ConverterParameter='0,100,fill'}"/>
                                <ColumnDefinition Width="{Binding FusionValue, Converter={StaticResource RangeBar}, ConverterParameter='0,100,rest'}"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" Background="{Binding FusionValue, Converter={StaticResource CsiColor}}"/>
                        </Grid>
                    </Grid>
                </Grid>

                <Rectangle Grid.Column="5" Width="2" Fill="#2A3A5A" Margin="0,20"/>

                <!-- ── NOX（设备直出镇痛指数）── -->
                <Grid Grid.Column="6" Margin="10,14,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="NOX" Style="{StaticResource VitalNameStyle}" Foreground="{StaticResource NoxAccentBrush}"/>
                        <TextBlock Text="设备镇痛指数" Style="{StaticResource VitalSubStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding NoxDisplay}" Style="{StaticResource VitalValueStyle}"
                               Foreground="{Binding NoxValue, Converter={StaticResource NoxColor}}"/>
                    <TextBlock Grid.Row="2" Text="{Binding NoxZone}" Style="{StaticResource VitalZoneStyle}"
                               Foreground="{Binding NoxValue, Converter={StaticResource NoxColor}}"/>
                    <Grid Grid.Row="3" Height="7" Margin="4,9,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*"/><ColumnDefinition Width="20*"/><ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="3" CornerRadius="3" Background="{StaticResource RangeTrackBrush}"/>
                            <Border Grid.Column="1" Background="{StaticResource RangeTargetBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding NoxValue, Converter={StaticResource RangeBar}, ConverterParameter='0,100,fill'}"/>
                                <ColumnDefinition Width="{Binding NoxValue, Converter={StaticResource RangeBar}, ConverterParameter='0,100,rest'}"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" Background="{Binding NoxValue, Converter={StaticResource NoxColor}}"/>
                        </Grid>
                    </Grid>
                </Grid>

                <Rectangle Grid.Column="7" Width="2" Fill="#2A3A5A" Margin="0,20"/>

                <!-- ── SpO₂（区间条按 90–100 缩放，否则 95–100 的正常窗只剩一条缝）── -->
                <Grid Grid.Column="8" Margin="10,14,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="SpO₂" Style="{StaticResource VitalNameStyle}" Foreground="{StaticResource Spo2AccentBrush}"/>
                        <TextBlock Text="血氧饱和度" Style="{StaticResource VitalSubStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Spo2Display}" Style="{StaticResource VitalValueStyle}"
                                   Foreground="{Binding Spo2Value, Converter={StaticResource Spo2Color}}"/>
                        <TextBlock Text="%" Style="{StaticResource VitalUnitStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding Spo2Zone}" Style="{StaticResource VitalZoneStyle}"
                               Foreground="{StaticResource MiniLabelBrush}" FontWeight="Normal"/>
                    <Grid Grid.Row="3" Height="7" Margin="4,9,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/><ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{StaticResource RangeTrackBrush}"/>
                            <Border Grid.Column="1" Background="{StaticResource RangeTargetBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Spo2Value, Converter={StaticResource RangeBar}, ConverterParameter='90,100,fill'}"/>
                                <ColumnDefinition Width="{Binding Spo2Value, Converter={StaticResource RangeBar}, ConverterParameter='90,100,rest'}"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" Background="{Binding Spo2Value, Converter={StaticResource Spo2Color}}"/>
                        </Grid>
                    </Grid>
                </Grid>

                <Rectangle Grid.Column="9" Width="1" Fill="#1B2942" Margin="0,26"/>

                <!-- ── 脉搏 PR（区间条按 30–150 bpm 缩放）── -->
                <Grid Grid.Column="10" Margin="10,14,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="脉搏 PR" Style="{StaticResource VitalNameStyle}" Foreground="{StaticResource PulseAccentBrush}"/>
                        <TextBlock Text="由红外脉搏波峰检测" Style="{StaticResource VitalSubStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PulseRateDisplay}" Style="{StaticResource VitalValueStyle}"
                                   Foreground="{Binding PulseRateValue, Converter={StaticResource PrColor}}"/>
                        <TextBlock Text="bpm" Style="{StaticResource VitalUnitStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding PulseRateZone}" Style="{StaticResource VitalZoneStyle}"
                               Foreground="{Binding PulseRateValue, Converter={StaticResource PrColor}}"/>
                    <Grid Grid.Row="3" Height="7" Margin="4,9,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="17*"/><ColumnDefinition Width="42*"/><ColumnDefinition Width="41*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="3" CornerRadius="3" Background="{StaticResource RangeTrackBrush}"/>
                            <Border Grid.Column="1" Background="{StaticResource RangeTargetBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding PulseRateValue, Converter={StaticResource RangeBar}, ConverterParameter='30,150,fill'}"/>
                                <ColumnDefinition Width="{Binding PulseRateValue, Converter={StaticResource RangeBar}, ConverterParameter='30,150,rest'}"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" Background="{Binding PulseRateValue, Converter={StaticResource PrColor}}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════ 回放控制条（仅文件回放模式） ═══════════ -->
        <Border DockPanel.Dock="Bottom" Background="#0A111E" BorderBrush="#1E2A44" BorderThickness="0,1,0,0"
                Visibility="{Binding IsPlaybackMode, Converter={StaticResource BoolToVis}}">
            <Grid Margin="18,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="回放进度" Foreground="{StaticResource MiniLabelBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Slider Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding IsConnected}"
                        Minimum="0" Maximum="{Binding PlaybackLength}" Value="{Binding PlaybackPosition, Mode=TwoWay}"
                        IsMoveToPointEnabled="True" SmallChange="1" LargeChange="30"
                        Foreground="{StaticResource AccentCyanBrush}"/>

                <TextBlock Grid.Column="2" Text="{Binding PlaybackTimeDisplay}" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0,18,0"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="倍率" Foreground="{StaticResource MiniLabelBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="78" Style="{StaticResource DarkComboStyle}" VerticalAlignment="Center"
                              ItemsSource="{Binding PlaybackSpeeds}"
                              SelectedValuePath="Value" SelectedValue="{Binding PlaybackSpeed}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ 底部工具栏 — 脑电 / 血氧 两路独立连接 ═══════════ -->
        <Border DockPanel.Dock="Bottom" Background="#0C1424" BorderBrush="#1E2A44" BorderThickness="0,1,0,0">
            <Grid Margin="18,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 脑电 -->
                    <TextBlock Text="脑电" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="112" Style="{StaticResource DarkComboStyle}" VerticalAlignment="Center"
                              ItemsSource="{Binding SourceModes}"
                              SelectedValuePath="Mode" SelectedValue="{Binding SelectedSourceMode}"
                              IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}" Margin="0,0,6,0"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVis}}">
                        <ComboBox Width="94" Style="{StaticResource DarkComboStyle}" VerticalAlignment="Center"
                                  ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"/>
                        <Button Content="⟳" Command="{Binding RefreshPortsCommand}" Style="{StaticResource ActionButtonStyle}"
                                Padding="9,4" Margin="4,0,6,0" ToolTip="刷新串口列表"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsPlaybackMode, Converter={StaticResource BoolToVis}}">
                        <Button Content="选择文件…" Command="{Binding BrowsePlaybackFileCommand}" Style="{StaticResource ActionButtonStyle}"
                                IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Text="{Binding PlaybackFileDisplay}" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" FontSize="12" Margin="8,0,6,0" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Command="{Binding ToggleConnectionCommand}" Width="86">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Content" Value="连接"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Content" Value="断开"/>
                                        <Setter Property="Background" Value="#33121A"/>
                                        <Setter Property="BorderBrush" Value="#FB5C6E"/>
                                        <Setter Property="Foreground" Value="#FB5C6E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Rectangle Width="1" Height="22" Fill="#243450" Margin="14,0"/>

                    <!-- 血氧（AFE4490 指夹模组，57600 8N1，独立于脑电链路） -->
                    <TextBlock Text="血氧" Foreground="{StaticResource Spo2AccentBrush}" FontWeight="Bold" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="96" Style="{StaticResource DarkComboStyle}" VerticalAlignment="Center"
                              ItemsSource="{Binding PpgSourceModes}"
                              SelectedValuePath="Mode" SelectedValue="{Binding SelectedPpgSourceMode}"
                              IsEnabled="{Binding IsPpgConnected, Converter={StaticResource InverseBool}}" Margin="0,0,6,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsPpgSerialMode, Converter={StaticResource BoolToVis}}">
                        <ComboBox Width="94" Style="{StaticResource DarkComboStyle}" VerticalAlignment="Center"
                                  ItemsSource="{Binding PpgPorts}" SelectedItem="{Binding SelectedPpgPort}"
                                  IsEnabled="{Binding IsPpgConnected, Converter={StaticResource InverseBool}}"/>
                        <Button Content="⟳" Command="{Binding RefreshPpgPortsCommand}" Style="{StaticResource ActionButtonStyle}"
                                Padding="9,4" Margin="4,0,6,0" ToolTip="刷新串口列表"/>
                    </StackPanel>
                    <Button Command="{Binding TogglePpgConnectionCommand}" Width="86">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Content" Value="连接"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPpgConnected}" Value="True">
                                        <Setter Property="Content" Value="断开"/>
                                        <Setter Property="Background" Value="#33121A"/>
                                        <Setter Property="BorderBrush" Value="#FB5C6E"/>
                                        <Setter Property="Foreground" Value="#FB5C6E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Rectangle Width="1" Height="22" Fill="#243450" Margin="14,0"/>

                    <Button Command="{Binding ToggleRecordingCommand}" Width="104" IsEnabled="{Binding IsConnected}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                <Setter Property="Content" Value="● 录制"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Content" Value="■ 停止录制"/>
                                        <Setter Property="Background" Value="#33121A"/>
                                        <Setter Property="BorderBrush" Value="#FB5C6E"/>
                                        <Setter Property="Foreground" Value="#FB5C6E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding RecordingStatus}" Foreground="{StaticResource RedCritBrush}" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MiniLabelBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,18,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="采样率 " Foreground="{StaticResource MiniLabelBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SampleRate, StringFormat={}{0} Hz}" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ 主显示区：左波形列 / 右明细列 ═══════════ -->
        <Grid Margin="6,4,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="38*"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────── 左列：四条波形 ─────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="0.95*"/>
                    <RowDefinition Height="1.15*"/>
                    <RowDefinition Height="1.15*"/>
                </Grid.RowDefinitions>

                <!-- EEG 原始波形 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid Margin="14,11">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="EEG 原始波形" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                <TextBlock Text="±127 µV · 近 6 秒" Style="{StaticResource CardTitleStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="成分分离" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource ActionButtonStyle}" Padding="10,3" FontSize="12"
                                    Click="OpenEegComponents_Click" IsEnabled="{Binding HasData}"
                                    ToolTip="弹窗查看 δ/θ/α/β 频带成分分离"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <oxy:PlotView Model="{Binding EegModel}" Background="Transparent"/>
                            <TextBlock Text="脑电设备未连接" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                       Visibility="{Binding HasData, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- PPG 红外脉搏波 -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid Margin="14,11">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="红外脉搏波" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PulseAccentBrush}"/>
                                <TextBlock Text="IR 通道 · 0.5–5 Hz 去基线 · 近 4 秒" Style="{StaticResource CardTitleStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource MiniLabelBrush}"
                                       Text="{Binding PpgLinkDisplay, StringFormat=链路 {0}}"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <oxy:PlotView Model="{Binding PpgModel}" Background="Transparent"/>
                            <!-- 血氧未连接时的空态提示 -->
                            <TextBlock Text="血氧模组未连接" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                       Visibility="{Binding IsPpgConnected, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 趋势 -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid Margin="14,11">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="趋势" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                <TextBlock Text="{Binding TrendSubtitle}" Style="{StaticResource CardTitleStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="整场报告" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource ActionButtonStyle}" Padding="10,3" FontSize="12"
                                    Click="OpenSessionReport_Click" IsEnabled="{Binding HasAnyData}"
                                    ToolTip="弹窗查看整场数据报告"/>
                        </Grid>
                        <oxy:PlotView Grid.Row="1" Model="{Binding TrendModel}" Background="Transparent" Margin="0,4,0,0"
                                      DefaultTrackerTemplate="{StaticResource TimeTrackerTemplate}"/>
                    </Grid>
                </Border>

                <!-- DSA -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <Grid Margin="14,11">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="密度谱阵列 DSA" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="频谱 1–44 Hz（设备直出）" Style="{StaticResource CardTitleStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <oxy:PlotView Grid.Row="1" Model="{Binding DsaModel}" Background="Transparent" Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <!-- 无数据占位（脉冲动画）：两路都没连时才盖住整列；只连了一路时由各卡片自己的空态提示接管 -->
                <Border Grid.Row="0" Grid.RowSpan="4" Background="#D40A0E1A" CornerRadius="14" Margin="6"
                        Visibility="{Binding HasAnyData, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="140" Height="140" HorizontalAlignment="Center">
                            <Ellipse x:Name="PulseRing" Width="140" Height="140" Stroke="{StaticResource AccentCyanBrush}"
                                     StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Opacity="0.6">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="PulseRing2" Width="140" Height="140" Stroke="{StaticResource AccentCyanBrush}"
                                     StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Opacity="0.6">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="18" Height="18" Fill="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding EmptyHint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                    </StackPanel>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.35" To="1.4" Duration="0:0:1.8"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.35" To="1.4" Duration="0:0:1.8"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:1.8"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.35" To="1.4" BeginTime="0:0:0.9" Duration="0:0:1.8"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.35" To="1.4" BeginTime="0:0:0.9" Duration="0:0:1.8"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseRing2" Storyboard.TargetProperty="Opacity" From="0.7" To="0" BeginTime="0:0:0.9" Duration="0:0:1.8"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>

            <!-- ─────────── 右列：明细 ─────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ═══ 血氧明细 ═══ -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel Margin="16,11">
                        <Grid Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="血氧明细" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Spo2AccentBrush}"/>
                                <TextBlock Text="AFE4490 指夹模组" Style="{StaticResource CardTitleStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Style="{StaticResource ChipStyle}" HorizontalAlignment="Right"
                                    ToolTip="标定曲线取自模组固件 S_spo2_algorithm.cpp 的 184 项查找表；该表为通用参考实现，非本模组的控制脱氧标定结果，不可用于诊断。">
                                <TextBlock Text="{Binding Spo2SourceLabel}" FontSize="10" Foreground="{StaticResource YellowWarnBrush}"/>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding PerfusionDisplay}" Style="{StaticResource TileValueStyle}"/>
                                <TextBlock Text="PI 灌注指数 %" Style="{StaticResource TileLabelStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding PrvDisplay}" Style="{StaticResource TileValueStyle}"/>
                                <TextBlock Text="PRV RMSSD ms" Style="{StaticResource TileLabelStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding RRatioDisplay}" Style="{StaticResource TileValueStyle}"/>
                                <TextBlock Text="比值 R" Style="{StaticResource TileLabelStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ 频带功率 + 频带比值 ═══ -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel Margin="16,11">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="频带功率 (dB) / 占比" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="Frequency Power" Style="{StaticResource MiniLabelStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBlock Text="δ Delta" Foreground="{StaticResource DeltaTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="13" CornerRadius="7" Background="#0E1626" ClipToBounds="True" VerticalAlignment="Center" Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding DeltaPower, Converter={StaticResource DbBar}, ConverterParameter=fill}"/>
                                        <ColumnDefinition Width="{Binding DeltaPower, Converter={StaticResource DbBar}, ConverterParameter=rest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="7" Background="{StaticResource DeltaBarBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding DeltaPower, StringFormat={}{0:0.0} dB}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding DeltaPct, StringFormat={}{0:0}%}" Foreground="{StaticResource DeltaTextBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBlock Text="θ Theta" Foreground="{StaticResource ThetaTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="13" CornerRadius="7" Background="#0E1626" ClipToBounds="True" VerticalAlignment="Center" Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ThetaPower, Converter={StaticResource DbBar}, ConverterParameter=fill}"/>
                                        <ColumnDefinition Width="{Binding ThetaPower, Converter={StaticResource DbBar}, ConverterParameter=rest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="7" Background="{StaticResource ThetaBarBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding ThetaPower, StringFormat={}{0:0.0} dB}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding ThetaPct, StringFormat={}{0:0}%}" Foreground="{StaticResource ThetaTextBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBlock Text="α Alpha" Foreground="{StaticResource AlphaTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="13" CornerRadius="7" Background="#0E1626" ClipToBounds="True" VerticalAlignment="Center" Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding AlphaPower, Converter={StaticResource DbBar}, ConverterParameter=fill}"/>
                                        <ColumnDefinition Width="{Binding AlphaPower, Converter={StaticResource DbBar}, ConverterParameter=rest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="7" Background="{StaticResource AlphaBarBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding AlphaPower, StringFormat={}{0:0.0} dB}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding AlphaPct, StringFormat={}{0:0}%}" Foreground="{StaticResource AlphaTextBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBlock Text="β Beta" Foreground="{StaticResource BetaTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="13" CornerRadius="7" Background="#0E1626" ClipToBounds="True" VerticalAlignment="Center" Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding BetaPower, Converter={StaticResource DbBar}, ConverterParameter=fill}"/>
                                        <ColumnDefinition Width="{Binding BetaPower, Converter={StaticResource DbBar}, ConverterParameter=rest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="7" Background="{StaticResource BetaBarBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding BetaPower, StringFormat={}{0:0.0} dB}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding BetaPct, StringFormat={}{0:0}%}" Foreground="{StaticResource BetaTextBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBlock Text="γ Gamma" Foreground="{StaticResource GammaTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="13" CornerRadius="7" Background="#0E1626" ClipToBounds="True" VerticalAlignment="Center" Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding GammaPower, Converter={StaticResource DbBar}, ConverterParameter=fill}"/>
                                        <ColumnDefinition Width="{Binding GammaPower, Converter={StaticResource DbBar}, ConverterParameter=rest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="7" Background="{StaticResource GammaBarBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding GammaPower, StringFormat={}{0:0.0} dB}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding GammaPct, StringFormat={}{0:0}%}" Foreground="{StaticResource GammaTextBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 频带比值（原中列独立卡，并入此处） -->
                        <Rectangle Height="1" Fill="#243450" Margin="0,9,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="δ" Foreground="{StaticResource DeltaTextBrush}" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="/" Foreground="{StaticResource MiniLabelBrush}" FontSize="15" Margin="2,0"/>
                                    <TextBlock Text="α" Foreground="{StaticResource AlphaTextBrush}" FontWeight="Bold" FontSize="15"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DeltaAlphaRatioDisplay}" FontSize="23" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Width="1" Fill="#243450" Margin="8,2"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="β" Foreground="{StaticResource BetaTextBrush}" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="/" Foreground="{StaticResource MiniLabelBrush}" FontSize="15" Margin="2,0"/>
                                    <TextBlock Text="α" Foreground="{StaticResource AlphaTextBrush}" FontWeight="Bold" FontSize="15"/>
                                </StackPanel>
                                <TextBlock Text="{Binding BetaAlphaRatioDisplay}" FontSize="23" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ 指标网格 4×2 ═══ -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <StackPanel Margin="13,11">
                        <TextBlock Text="信号与电极" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="3,0,0,7"/>
                        <UniformGrid Columns="4" Rows="2">
                            <Border Style="{StaticResource MetricTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding BsDisplay}" Style="{StaticResource TileValueStyle}"/>
                                    <TextBlock Text="BS 爆发抑制" Style="{StaticResource TileLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SqiDisplay}" Style="{StaticResource TileValueStyle}"
                                               Foreground="{Binding SqiValue, Converter={StaticResource SqiColor}}"/>
                                    <TextBlock Text="SQI 信号质量" Style="{StaticResource TileLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EmgDisplay}" Style="{StaticResource TileValueStyle}"/>
                                    <TextBlock Text="EMG 肌电" Style="{StaticResource TileLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Sef95Value, StringFormat={}{0:0}}" Style="{StaticResource TileValueStyle}"
                                               Foreground="{StaticResource GoldBrush}"/>
                                    <TextBlock Text="SEF95 Hz" Style="{StaticResource TileLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EogDisplay}" Style="{StaticResource TileValueStyle}"/>
                                    <TextBlock Text="EOG 眼动" Style="{StaticResource TileLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding BlackImpedanceDisplay}" Style="{StaticResource TileValueStyle}"/>
                                    <TextBlock Text="黑电极阻抗" Style="{StaticResource TileLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding WhiteImpedanceDisplay}" Style="{StaticResource TileValueStyle}"/>
                                    <TextBlock Text="白电极阻抗" Style="{StaticResource TileLabelStyle}"/>
                                </StackPanel>
                            </Border>
                            <!-- 电极状态：ElectrodeWarning 此前在界面上无处显示，这里给它一个位置 -->
                            <Border Style="{StaticResource MetricTileStyle}" ToolTip="{Binding ElectrodeWarning}">
                                <StackPanel>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TileValueStyle}">
                                                <Setter Property="FontSize" Value="17"/>
                                                <Setter Property="Text" Value="正常"/>
                                                <Setter Property="Foreground" Value="{StaticResource GreenOkBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasElectrodeWarning}" Value="True">
                                                        <Setter Property="Text" Value="⚠ 异常"/>
                                                        <Setter Property="Foreground" Value="{StaticResource RedCritBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="电极状态" Style="{StaticResource TileLabelStyle}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ═══ 临床事件 ═══ -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <Grid Margin="14,11">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="临床事件" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="Clinical Events" Style="{StaticResource CardTitleStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,9,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Width="96" Style="{StaticResource DarkComboStyle}" VerticalAlignment="Center"
                                      ItemsSource="{Binding EventTypes}"
                                      SelectedValuePath="Type" SelectedValue="{Binding SelectedAnnotationType}"/>
                            <TextBox Grid.Column="1" Margin="6,0" VerticalContentAlignment="Center" Height="30"
                                     Background="#152138" Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="#2A3A5A" CaretBrush="{StaticResource TextPrimaryBrush}"
                                     Text="{Binding AnnotationNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="备注（可选）"/>
                            <Button Grid.Column="2" Content="标注" Width="58" Command="{Binding AddAnnotationCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#14203A" CornerRadius="8" Padding="12,8" Margin="0,3"
                                                BorderBrush="{Binding Accent}" BorderThickness="3,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Time}" Foreground="{Binding Accent}" FontSize="11"/>
                                                        <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource MiniLabelBrush}" FontSize="11" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CsiText}" Foreground="{StaticResource MiniLabelBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
