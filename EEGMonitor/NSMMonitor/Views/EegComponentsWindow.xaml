<Window x:Class="NSMMonitor.Views.EegComponentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="脑电成分分离" Height="760" Width="940"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei, Segoe UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
            <TextBlock Text="脑电成分分离" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
            <TextBlock Text="δ / θ / α / β 频带分离（FFT 带通，不含 γ）" Foreground="{StaticResource MiniLabelBrush}"
                       VerticalAlignment="Bottom" Margin="12,0,0,2" FontSize="12"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="原始 EEG" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="Raw" Foreground="{StaticResource MiniLabelBrush}" FontSize="10"/>
                    </StackPanel>
                    <oxy:PlotView Grid.Column="1" x:Name="RawPlot" Background="Transparent"/>
                    <TextBlock Grid.Column="2" Text="功率 / 占比" Foreground="{StaticResource MiniLabelBrush}"
                               FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="δ Delta" Foreground="{StaticResource DeltaTextBrush}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="1–3 Hz" Foreground="{StaticResource MiniLabelBrush}" FontSize="10"/>
                    </StackPanel>
                    <oxy:PlotView Grid.Column="1" x:Name="DeltaPlot" Background="Transparent"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="DeltaDb" Text="-- dB" Foreground="{StaticResource DeltaTextBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="DeltaPctLbl" Text="--" Foreground="{StaticResource MiniLabelBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="θ Theta" Foreground="{StaticResource ThetaTextBrush}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="4–7 Hz" Foreground="{StaticResource MiniLabelBrush}" FontSize="10"/>
                    </StackPanel>
                    <oxy:PlotView Grid.Column="1" x:Name="ThetaPlot" Background="Transparent"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ThetaDb" Text="-- dB" Foreground="{StaticResource ThetaTextBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="ThetaPctLbl" Text="--" Foreground="{StaticResource MiniLabelBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="α Alpha" Foreground="{StaticResource AlphaTextBrush}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="8–13 Hz" Foreground="{StaticResource MiniLabelBrush}" FontSize="10"/>
                    </StackPanel>
                    <oxy:PlotView Grid.Column="1" x:Name="AlphaPlot" Background="Transparent"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="AlphaDb" Text="-- dB" Foreground="{StaticResource AlphaTextBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="AlphaPctLbl" Text="--" Foreground="{StaticResource MiniLabelBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="β Beta" Foreground="{StaticResource BetaTextBrush}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="14–30 Hz" Foreground="{StaticResource MiniLabelBrush}" FontSize="10"/>
                    </StackPanel>
                    <oxy:PlotView Grid.Column="1" x:Name="BetaPlot" Background="Transparent"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="BetaDb" Text="-- dB" Foreground="{StaticResource BetaTextBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="BetaPctLbl" Text="--" Foreground="{StaticResource MiniLabelBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
