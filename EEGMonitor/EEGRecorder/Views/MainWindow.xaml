<Window x:Class="EEGRecorder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:EEGRecorder.Controls"
        xmlns:vm="clr-namespace:EEGRecorder.ViewModels"
        Title="脑电/脉搏 原始信号记录仪" Height="780" Width="1180"
        MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.DataContext><vm:MainViewModel/></Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Top bar ══ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="6,6,6,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="18" Height="18" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="脑电/脉搏 原始信号记录仪" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PortSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding NowText}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ No-data banner ══ -->
        <Border Grid.Row="1" Margin="6,6,6,0" CornerRadius="6" Padding="14,8"
                Background="#33F59E0B" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                Visibility="{Binding NoDataVisible, Converter={StaticResource B2V}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse Width="11" Height="11" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding NoDataText}" Foreground="{StaticResource WarnBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══ Body ══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- waveforms -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.4*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- EEG -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="脑电 EEG · 原始(显示已滤波 0.5–45Hz + 50Hz 陷波)" Style="{StaticResource PanelTitle}"/>
                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A22C55E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElectrodeBad}" Value="True">
                                                <Setter Property="Background" Value="#1AEF4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ElectrodeStatus}" FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElectrodeBad}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding EegInfo}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                        <Border Background="#FF080D14" CornerRadius="6">
                            <ctrl:WaveformView Source="{Binding EegSource}" Stroke="{StaticResource EegBrush}" StrokeThickness="1.2" Margin="4"/>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- PPG -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="脉搏 PPG · IR 脉搏波(显示 0.5–5Hz)" Style="{StaticResource PanelTitle}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="HR" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,4,2"/>
                                <TextBlock Text="{Binding DeviceHr}" Foreground="{StaticResource PpgBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="SpO₂" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="14,0,4,2"/>
                                <TextBlock Text="{Binding DeviceSpo2}" Foreground="{StaticResource EegBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="%" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding PpgInfo}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                        <Border Background="#FF080D14" CornerRadius="6">
                            <ctrl:WaveformView Source="{Binding PpgSource}" Stroke="{StaticResource PpgBrush}" StrokeThickness="1.4" Margin="4"/>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- control column -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="采集会话" Style="{StaticResource PanelTitle}"/>

                    <!-- session inputs -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                        <TextBlock Text="受试者 / 编号" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="备注" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,3"/>
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="52" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        <TextBlock Text="存储目录" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,3"/>
                        <TextBox Text="{Binding OutputDir}" IsReadOnly="True" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <!-- buttons + status (bottom) -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Height="38" Margin="0,8,0,0" Content="{Binding ConnectButtonText}"
                                Style="{StaticResource SecondaryButton}" Command="{Binding ToggleConnectCommand}"/>

                        <Button Height="64" Margin="0,10,0,0" Content="{Binding RecordButtonText}"
                                Command="{Binding ToggleRecordCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RecordButton}">
                                    <Setter Property="Background"><Setter.Value><SolidColorBrush Color="#22C55E"/></Setter.Value></Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Background"><Setter.Value><SolidColorBrush Color="#EF4444"/></Setter.Value></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,3"><TextBlock Text="录制时长" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding RecordElapsed}" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/></DockPanel>
                            <DockPanel Grid.Row="1" Margin="0,3"><TextBlock Text="EEG" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding EegFileSize}" Foreground="{StaticResource TextBrush}" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
                            <DockPanel Grid.Row="2" Margin="0,3"><TextBlock Text="PPG" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding PpgFileSize}" Foreground="{StaticResource TextBrush}" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
                            <DockPanel Grid.Row="3" Margin="0,3"><TextBlock Text="剩余空间" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding FreeSpace}" Foreground="{StaticResource TextBrush}" FontSize="12" HorizontalAlignment="Right"/></DockPanel>
                        </Grid>

                        <Button Height="32" Margin="0,10,0,0" Content="打开存储文件夹"
                                Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}"/>
                        <TextBlock Text="{Binding SessionPath}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Grid/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ══ Status line ══ -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Margin="6,0,6,6" CornerRadius="6" Padding="12,6">
            <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
