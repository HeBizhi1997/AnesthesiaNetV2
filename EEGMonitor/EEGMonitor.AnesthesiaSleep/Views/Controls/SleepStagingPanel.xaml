<UserControl x:Class="EEGMonitor.AnesthesiaSleep.Views.Controls.SleepStagingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:conv="clr-namespace:EEGMonitor.AnesthesiaSleep.Views.Converters"
             Background="{StaticResource BgPanelBrush}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 当前分期标识 -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="16,10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="当前分期:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Ellipse Width="16" Height="16" Margin="0,0,8,0"
                         Fill="{Binding CurrentStage, Converter={StaticResource StageColorConverter}}"/>
                <TextBlock Text="{Binding CurrentStage, Converter={StaticResource StageLabelConverter}}"
                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                    <Run Text="置信度: "/>
                    <Run Text="{Binding CurrentConfidence, StringFormat={}{0:P1}}"
                         Foreground="{StaticResource TextPrimaryBrush}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 图例 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="图例:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Border CornerRadius="2" Padding="6,2" Margin="0,0,8,0" Background="#0C1422">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="N2" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="2" Padding="6,2" Margin="0,0,8,0" Background="#0C1422">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource DeltaBrush}" Margin="0,0,4,0"/>
                    <TextBlock Text="N3" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="2" Padding="6,2" Margin="0,0,8,0" Background="#0C1422">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#E040C0" Margin="0,0,4,0"/>
                    <TextBlock Text="REM" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="2" Padding="6,2" Margin="0,0,8,0" Background="#0C1422">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#F0A020" Margin="0,0,4,0"/>
                    <TextBlock Text="N1" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="2" Padding="6,2" Margin="0,0,8,0" Background="#0C1422">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#6B7080" Margin="0,0,4,0"/>
                    <TextBlock Text="清醒" FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="|" Foreground="{StaticResource BorderBrush}" VerticalAlignment="Center" Margin="4,0"/>
            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                <Run Text="总计 Epoch: "/>
                <Run Text="{Binding EpochCount}" Foreground="{StaticResource TextPrimaryBrush}"/>
            </TextBlock>
        </StackPanel>

        <!-- 催眠图 -->
        <oxy:PlotView Grid.Row="2" Model="{Binding HypnogramModel}" Margin="0,4"/>

        <!-- 近期 Epoch 条带 -->
        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Height="60" Margin="0,4,0,0">
            <ItemsControl ItemsSource="{Binding RecentEpochs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="6" Height="48" CornerRadius="1" Margin="1,0"
                                Background="{Binding Stage, Converter={StaticResource StageColorConverter}}"
                                ToolTip="{Binding Stage}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
