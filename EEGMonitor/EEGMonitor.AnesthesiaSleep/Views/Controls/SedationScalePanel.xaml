<UserControl x:Class="EEGMonitor.AnesthesiaSleep.Views.Controls.SedationScalePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPanelBrush}">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 评分录入 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
            <StackPanel>
                <TextBlock Text="镇静评估" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,10"/>

                <!-- 量表类型选择 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Ramsay" Width="80"
                            Command="{Binding SetScaleTypeCommand}" CommandParameter="Ramsay"
                            Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="RASS" Width="60"
                            Command="{Binding SetScaleTypeCommand}" CommandParameter="RASS"
                            Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="MOAA/S" Width="70"
                            Command="{Binding SetScaleTypeCommand}" CommandParameter="MOAAS"
                            Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding SelectedScaleType, StringFormat=' [{0}]'}"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 评分快捷按钮 -->
                <TextBlock Text="评分" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="5" Command="{Binding SetScoreCommand}" CommandParameter="5"
                            Style="{StaticResource ActionButtonStyle}" Width="36" Height="30" Margin="0,0,4,4"/>
                    <Button Content="4" Command="{Binding SetScoreCommand}" CommandParameter="4"
                            Style="{StaticResource ActionButtonStyle}" Width="36" Height="30" Margin="0,0,4,4"/>
                    <Button Content="3" Command="{Binding SetScoreCommand}" CommandParameter="3"
                            Style="{StaticResource ActionButtonStyle}" Width="36" Height="30" Margin="0,0,4,4"/>
                    <Button Content="2" Command="{Binding SetScoreCommand}" CommandParameter="2"
                            Style="{StaticResource ActionButtonStyle}" Width="36" Height="30" Margin="0,0,4,4"/>
                    <Button Content="1" Command="{Binding SetScoreCommand}" CommandParameter="1"
                            Style="{StaticResource ActionButtonStyle}" Width="36" Height="30" Margin="0,0,4,4"/>
                    <Button Content="0" Command="{Binding SetScoreCommand}" CommandParameter="0"
                            Style="{StaticResource ActionButtonStyle}" Width="36" Height="30" Margin="0,0,4,4"/>
                </WrapPanel>

                <!-- 当前得分展示 -->
                <Border Background="#0A1220" Padding="8" Margin="0,4">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}">
                            <Run Text="{Binding SelectedScaleType, StringFormat='{}{0}'}"/>
                            <Run Text=" 评分: "/>
                            <Run Text="{Binding SelectedScore}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedScoreLabel}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="评估者" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,2"/>
                <TextBox Text="{Binding Observer, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBoxStyle}"/>

                <TextBlock Text="备注" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,2"/>
                <TextBox Text="{Binding SedationNotes, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBoxStyle}" Height="40" TextWrapping="Wrap"/>

                <Button Content="记录评估" Margin="0,10,0,0"
                        Command="{Binding RecordAssessmentCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                            <Setter Property="Background" Value="#0A2A14"/>
                            <Setter Property="Foreground" Value="{StaticResource GreenOkBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource GreenOkBrush}"/>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- 评估历史 -->
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="8,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="评估历史" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0C1422" Padding="8,6" Margin="0,2"
                                        BorderBrush="#182C46" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}">
                                                <Run Text="{Binding ScaleType, StringFormat={}{0}}"/>
                                                <Run Text=" : "/>
                                                <Run Text="{Binding Score}" FontWeight="Bold"
                                                     Foreground="{StaticResource AccentCyanBrush}"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding ScoreLabel}" FontSize="10"
                                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
