<Window x:Class="Ads1299Monitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:ctrl="clr-namespace:Ads1299Monitor.Controls"
        Title="麻醉深度监测系统 · ADS1299" Height="980" Width="1480"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style TargetType="lvc:CartesianChart"><Setter Property="Background" Value="Transparent"/></Style>
        <Style TargetType="lvc:PieChart"><Setter Property="Background" Value="Transparent"/></Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="VitalName" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Alert banners (no-data watchdog + lead-off) ══ -->
        <StackPanel Grid.Row="1">
            <!-- No-data: serial open but no frames (device power off / cable / hung) -->
            <Border Margin="6,6,6,0" CornerRadius="6" Padding="14,8"
                    Background="#33F59E0B" BorderBrush="{StaticResource BetaBrush}" BorderThickness="1"
                    Visibility="{Binding NoDataVisible, Converter={StaticResource B2V}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="11" Height="11" Fill="{StaticResource BetaBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding NoDataText}" Foreground="{StaticResource BetaBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <!-- Lead-off / electrode (data flowing but invalid) -->
            <Border Margin="6,6,6,0" CornerRadius="6" Padding="14,8"
                    Background="#33EF4444" BorderBrush="{StaticResource GammaBrush}" BorderThickness="1"
                    Visibility="{Binding ElectrodeAlertVisible, Converter={StaticResource B2V}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="11" Height="11" Fill="{StaticResource GammaBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ElectrodeAlert}" Foreground="{StaticResource GammaBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══ Top bar ══ -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="16,8" Margin="6,6,6,0" CornerRadius="8">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse Width="22" Height="22" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="麻醉深度监测系统" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#FF0F1A28" CornerRadius="14" Padding="12,5" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource AlphaBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding MonitorStatusText}" Foreground="{StaticResource TextBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MonitorElapsed}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF2A1418" CornerRadius="14" Padding="12,5" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource GammaBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="录制" Foreground="{StaticResource GammaBrush}" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RecordElapsed}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#FF0F1A28" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource GammaBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServiceOnline}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AlphaBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ServiceStatus}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding NowText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="截图" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="设置"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Body ══ -->
        <Grid Grid.Row="2">
            <!-- ── Main content (left sidebar removed) ── -->
            <Grid Margin="6,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.35*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="0.9*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Patient bar -->
                <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="姓名: " Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding PatientName}" Foreground="{StaticResource TextBrush}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding PatientGender}" Foreground="{StaticResource ThetaBrush}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="住院号: " Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding AdmissionNo}" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="年龄: " Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding PatientAge}" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="手术间: " Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding OperatingRoom}" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="手术名称: " Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding SurgeryName}" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="麻醉方式: " Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding AnesthesiaMethod}" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. EEG waveforms -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="1.  脑电波形" Style="{StaticResource PanelTitle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="增益" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="64" SelectedIndex="0"><ComboBoxItem Content="7.5µV"/><ComboBoxItem Content="15µV"/><ComboBoxItem Content="30µV"/></ComboBox>
                                <TextBlock Text="时间窗" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                <ComboBox Width="58" SelectedIndex="0"><ComboBoxItem Content="10s"/><ComboBoxItem Content="20s"/><ComboBoxItem Content="30s"/></ComboBox>
                            </StackPanel>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="46"/>
                            </Grid.ColumnDefinitions>
                            <!-- lane labels -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" VerticalAlignment="Center"><TextBlock Text="原始EEG" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="12"/><TextBlock Text="0.5–70 Hz" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="δ 波" Foreground="{StaticResource ThetaBrush}" FontWeight="Bold" FontSize="12"/><TextBlock Text="0.5–4 Hz" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                <StackPanel Grid.Row="2" VerticalAlignment="Center"><TextBlock Text="θ 波" Foreground="#FF06B6D4" FontWeight="Bold" FontSize="12"/><TextBlock Text="4–8 Hz" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                <StackPanel Grid.Row="3" VerticalAlignment="Center"><TextBlock Text="α 波" Foreground="{StaticResource AlphaBrush}" FontWeight="Bold" FontSize="12"/><TextBlock Text="8–13 Hz" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                <StackPanel Grid.Row="4" VerticalAlignment="Center"><TextBlock Text="β 波" Foreground="{StaticResource BetaBrush}" FontWeight="Bold" FontSize="12"/><TextBlock Text="13–30 Hz" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                <StackPanel Grid.Row="5" VerticalAlignment="Center"><TextBlock Text="γ 波" Foreground="{StaticResource DeltaBrush}" FontWeight="Bold" FontSize="12"/><TextBlock Text="30–70 Hz" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                            </Grid>
                            <lvc:CartesianChart Grid.Column="1" Series="{Binding EegSeries}"
                                                XAxes="{Binding EegXAxes}" YAxes="{Binding EegYAxes}"
                                                TooltipPosition="Hidden"/>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="50µV" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="50µV" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Text="50µV" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Text="50µV" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Text="50µV" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="5" Text="50µV" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 2. Vital signs -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="2.  生命体征" Style="{StaticResource PanelTitle}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="ctrl:Sparkline"><Setter Property="Width" Value="110"/><Setter Property="Margin" Value="6,0"/></Style>
                            </Grid.Resources>

                            <!-- HR -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="HR" Foreground="{StaticResource AlphaBrush}" FontWeight="Bold"/><TextBlock Text="心率" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding HrText}" Foreground="{StaticResource AlphaBrush}" FontSize="34" FontWeight="Bold"/><TextBlock Text="bpm" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,6"/></StackPanel>
                                <ctrl:Sparkline Grid.Column="2" Values="{Binding HrSpark}" Stroke="{StaticResource AlphaBrush}"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="160" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="40" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,14,0,0"/></StackPanel>
                            </Grid>
                            <!-- SPO2 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="SPO₂" Foreground="{StaticResource ThetaBrush}" FontWeight="Bold"/><TextBlock Text="血氧饱和度" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Spo2Text}" Foreground="{StaticResource ThetaBrush}" FontSize="34" FontWeight="Bold"/><TextBlock Text="%" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,6"/></StackPanel>
                                <ctrl:Sparkline Grid.Column="2" Values="{Binding Spo2Spark}" Stroke="{StaticResource ThetaBrush}"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="100" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="90" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,14,0,0"/></StackPanel>
                            </Grid>
                            <!-- HRV -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="HRV" Foreground="#FF22D3EE" FontWeight="Bold"/><TextBlock Text="心率变异性" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding HrvText}" Foreground="#FF22D3EE" FontSize="34" FontWeight="Bold"/><TextBlock Text="ms" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,6"/></StackPanel>
                                <ctrl:Sparkline Grid.Column="2" Values="{Binding HrvSpark}" Stroke="#FF22D3EE"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="100" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="0" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,14,0,0"/></StackPanel>
                            </Grid>
                            <!-- NIBP -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="NIBP" Foreground="{StaticResource BetaBrush}" FontWeight="Bold"/><TextBlock Text="无创血压" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding NibpText}" Foreground="{StaticResource BetaBrush}" FontSize="30" FontWeight="Bold"/><TextBlock Text="mmHg" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="6,0,8,6"/><TextBlock Text="{Binding MapText}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,6"/></StackPanel>
                            </Grid>
                            <!-- RR -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="RR" Foreground="{StaticResource DeltaBrush}" FontWeight="Bold"/><TextBlock Text="呼吸频率" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding RrText}" Foreground="{StaticResource DeltaBrush}" FontSize="34" FontWeight="Bold"/><TextBlock Text="rpm" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,6"/></StackPanel>
                                <ctrl:Sparkline Grid.Column="2" Values="{Binding RrSpark}" Stroke="{StaticResource DeltaBrush}"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="30" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="0" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,14,0,0"/></StackPanel>
                            </Grid>
                            <!-- TPI -->
                            <Grid Grid.Row="5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="TPI" Foreground="#FFA855F7" FontWeight="Bold"/><TextBlock Text="灌注指数" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding TpiText}" Foreground="#FFA855F7" FontSize="34" FontWeight="Bold"/></StackPanel>
                                <ctrl:Sparkline Grid.Column="2" Values="{Binding TpiSpark}" Stroke="#FFA855F7"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="10" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="0" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,14,0,0"/></StackPanel>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 3. Indices -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="3.  意识指标 &amp; 信号质量" Style="{StaticResource PanelTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <!-- qCON -->
                            <Border Grid.Column="0" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                        <TextBlock Text="qCON" Foreground="{StaticResource TextBrush}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="意识水平指数" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <lvc:PieChart Grid.Row="1" Series="{Binding QConGauge}" InitialRotation="-225" MaxAngle="270" MinValue="0" MaxValue="100" TooltipPosition="Hidden" Margin="2"/>
                                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                                        <Border Background="#FF13243A" CornerRadius="4" Padding="8,2">
                                            <TextBlock><Run Text="意识: " Foreground="#FF7D8B9A"/><Run Text="{Binding QConStatus}" Foreground="#FF22D3A6"/></TextBlock>
                                        </Border>
                                        <DockPanel Width="120" Margin="0,4,0,0"><TextBlock Text="0" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="100" Foreground="{StaticResource MutedBrush}" FontSize="9" DockPanel.Dock="Right"/></DockPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- qNOX -->
                            <Border Grid.Column="1" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                        <TextBlock Text="qNOX" Foreground="{StaticResource TextBrush}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="麻醉深度指数" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <lvc:PieChart Grid.Row="1" Series="{Binding QNoxGauge}" InitialRotation="-225" MaxAngle="270" MinValue="0" MaxValue="100" TooltipPosition="Hidden" Margin="2"/>
                                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                                        <Border Background="#FF13243A" CornerRadius="4" Padding="8,2">
                                            <TextBlock><Run Text="深度: " Foreground="#FF7D8B9A"/><Run Text="{Binding QNoxStatus}" Foreground="#FF22C55E"/></TextBlock>
                                        </Border>
                                        <DockPanel Width="120" Margin="0,4,0,0"><TextBlock Text="0" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="100" Foreground="{StaticResource MutedBrush}" FontSize="9" DockPanel.Dock="Right"/></DockPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- SQI -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                                    <TextBlock Text="SQI" Foreground="{StaticResource TextBrush}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="信号质量指数" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Text="{Binding SqiText}" Foreground="{StaticResource AlphaBrush}" FontSize="56" FontWeight="Bold"/>
                                    <TextBlock Text="/100" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,10"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                                    <ProgressBar Width="130" Height="6" Minimum="0" Maximum="100" Value="{Binding Sqi}" Background="#FF152033" Foreground="{StaticResource AlphaBrush}" BorderThickness="0"/>
                                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center"><Run Text="信号质量: " Foreground="#FF7D8B9A"/><Run Text="{Binding SqiQuality}" Foreground="#FF22C55E"/></TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 5. Donut -->
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="5.  脑电成分功率占比" Style="{StaticResource PanelTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="178"/></Grid.ColumnDefinitions>
                            <lvc:PieChart Grid.Column="0" Series="{Binding DonutSeries}" TooltipPosition="Hidden"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <DockPanel Margin="0,6"><Ellipse Width="12" Height="12" Fill="{StaticResource DeltaBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding DeltaPct}" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock Text="  δ (0.5–4 Hz)" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/></DockPanel>
                                <DockPanel Margin="0,6"><Ellipse Width="12" Height="12" Fill="{StaticResource ThetaBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding ThetaPct}" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock Text="  θ (4–8 Hz)" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/></DockPanel>
                                <DockPanel Margin="0,6"><Ellipse Width="12" Height="12" Fill="{StaticResource AlphaBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding AlphaPct}" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock Text="  α (8–13 Hz)" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/></DockPanel>
                                <DockPanel Margin="0,6"><Ellipse Width="12" Height="12" Fill="{StaticResource BetaBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding BetaPct}" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock Text="  β (13–30 Hz)" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/></DockPanel>
                                <DockPanel Margin="0,6"><Ellipse Width="12" Height="12" Fill="{StaticResource GammaBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding GammaPct}" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock Text="  γ (30–70 Hz)" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/></DockPanel>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 4. Trend (full width) -->
                <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                            <TextBlock Text="4.  趋势图 (关键参数趋势)" Style="{StaticResource PanelTitle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="qCON" IsChecked="True" Foreground="#FF3B82F6" Margin="6,0"/>
                                <CheckBox Content="qNOX" IsChecked="True" Foreground="#FFF59E0B" Margin="6,0"/>
                                <CheckBox Content="SQI" IsChecked="True" Foreground="#FF22C55E" Margin="6,0"/>
                                <CheckBox Content="HR" IsChecked="True" Foreground="#FFEF4444" Margin="6,0"/>
                                <CheckBox Content="SPO₂" Foreground="#FF38BDF8" Margin="6,0"/>
                            </StackPanel>
                        </DockPanel>
                        <lvc:CartesianChart Series="{Binding TrendSeries}" XAxes="{Binding TrendXAxes}"
                                            YAxes="{Binding TrendYAxes}" Sections="{Binding TrendSections}"
                                            TooltipPosition="Hidden"/>
                    </DockPanel>
                </Border>

                <!-- 7. Event log -->
                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Command="{Binding AddEventCommand}"
                                    Style="{StaticResource SecondaryButton}" Padding="12,4" VerticalAlignment="Center">
                                <TextBlock Text="＋ 添加事件" FontSize="12"/>
                            </Button>
                            <TextBlock Text="7.  事件记录" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#FF0E1620"
                                  Foreground="{StaticResource TextBrush}" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#FF1A2430" HeadersVisibility="Column" FontSize="12">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FF0E1620"/>
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="80"/>
                                <DataGridTextColumn Header="事件类型" Binding="{Binding Category}" Width="90"/>
                                <DataGridTextColumn Header="名称/药物" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="剂量/参数" Binding="{Binding Dose}" Width="100"/>
                                <DataGridTextColumn Header="操作者" Binding="{Binding Operator}" Width="80"/>
                                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- 8. Recording -->
                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="8.  数据录制" Style="{StaticResource PanelTitle}"/>
                        <StackPanel VerticalAlignment="Top" Margin="2,4,2,0">
                            <Border Background="#FF1A0F12" CornerRadius="6" Padding="12,8">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="11" Height="11" Fill="{StaticResource GammaBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding MonitorStatusText}" Foreground="{StaticResource GammaBrush}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RecordElapsed}" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Button Margin="0,10,0,0" Height="40" Command="{Binding ToggleCommand}"
                                    Content="{Binding StartButtonText}" Style="{StaticResource StartButton}"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,3"><TextBlock Text="文件名: " Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding RecordFileName}" Foreground="{StaticResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/></DockPanel>
                                <DockPanel Grid.Row="1" Margin="0,3"><TextBlock Text="存储位置: " Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding StoragePath}" Foreground="{StaticResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/></DockPanel>
                                <DockPanel Grid.Row="2" Margin="0,3"><TextBlock Text="剩余存储: " Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding FreeSpaceText}" Foreground="{StaticResource TextBrush}" FontSize="12"/></DockPanel>
                            </Grid>

                            <Button Margin="0,12,0,0" Height="36" Command="{Binding MarkMomentCommand}"
                                    Content="标记当前时刻" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
