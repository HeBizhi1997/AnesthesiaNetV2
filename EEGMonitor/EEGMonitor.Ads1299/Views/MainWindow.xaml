<Window x:Class="Ads1299Monitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="麻醉深度监测系统 · ADS1299" Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="86"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Top bar ── -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="16,8" Margin="5,5,5,0" CornerRadius="8">
            <DockPanel>
                <TextBlock Text="麻醉深度监测系统" Foreground="{StaticResource AccentBrush}"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FF152033" CornerRadius="4" Padding="10,3" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SQI " Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding SqiText}" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="" />
            </DockPanel>
        </Border>

        <!-- ── Main content ── -->
        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left: index cards -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="qCON  催眠指数" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Grid.Row="1" Text="{Binding QConText}" Style="{StaticResource BigNumber}" Foreground="{StaticResource GammaBrush}"/>
                        <TextBlock Grid.Row="2" Text="DL 预测 (0–100)   靶区 40–60" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="qNOX  伤害感受" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Grid.Row="1" Text="{Binding QNoxText}" Style="{StaticResource BigNumber}" Foreground="{StaticResource BetaBrush}"/>
                        <TextBlock Grid.Row="2" Text="响应熵 RE (0–100)   每 10s" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="SQI  信号质量" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Grid.Row="1" Text="{Binding SqiText}" Style="{StaticResource BigNumber}" Foreground="{StaticResource DeltaBrush}"/>
                        <ProgressBar Grid.Row="2" Height="6" Minimum="0" Maximum="100" Value="{Binding Sqi}"
                                     Background="#FF152033" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Center: charts -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- B. EEG bands -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="B.  EEG 脑电频段分解 (滤波后 5 频段)" Style="{StaticResource PanelTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Stretch">
                                <TextBlock Text="γ" Foreground="{StaticResource GammaBrush}" FontWeight="Bold" Margin="0,6" Height="20"/>
                                <TextBlock Text="β" Foreground="{StaticResource BetaBrush}"  FontWeight="Bold" Margin="0,6" Height="20"/>
                                <TextBlock Text="α" Foreground="{StaticResource AlphaBrush}" FontWeight="Bold" Margin="0,6" Height="20"/>
                                <TextBlock Text="θ" Foreground="{StaticResource ThetaBrush}" FontWeight="Bold" Margin="0,6" Height="20"/>
                                <TextBlock Text="δ" Foreground="{StaticResource DeltaBrush}" FontWeight="Bold" Margin="0,6" Height="20"/>
                            </StackPanel>
                            <oxy:PlotView Grid.Column="1" Model="{Binding EegBandsModel}" Background="Transparent"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- C. DSA -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="C.  脑电频带能量相对占比 (DSA)  — δ / θ / α / β / γ" Style="{StaticResource PanelTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="92"/>
                            </Grid.ColumnDefinitions>
                            <oxy:PlotView Grid.Column="0" Model="{Binding DsaModel}" Background="Transparent"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <DockPanel Margin="0,3"><TextBlock Text="γ" Foreground="{StaticResource GammaBrush}" FontWeight="Bold"/><TextBlock Text="{Binding GammaPct}" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Right"/></DockPanel>
                                <DockPanel Margin="0,3"><TextBlock Text="β" Foreground="{StaticResource BetaBrush}"  FontWeight="Bold"/><TextBlock Text="{Binding BetaPct}"  Foreground="{StaticResource TextBrush}" DockPanel.Dock="Right"/></DockPanel>
                                <DockPanel Margin="0,3"><TextBlock Text="α" Foreground="{StaticResource AlphaBrush}" FontWeight="Bold"/><TextBlock Text="{Binding AlphaPct}" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Right"/></DockPanel>
                                <DockPanel Margin="0,3"><TextBlock Text="θ" Foreground="{StaticResource ThetaBrush}" FontWeight="Bold"/><TextBlock Text="{Binding ThetaPct}" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Right"/></DockPanel>
                                <DockPanel Margin="0,3"><TextBlock Text="δ" Foreground="{StaticResource DeltaBrush}" FontWeight="Bold"/><TextBlock Text="{Binding DeltaPct}" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Right"/></DockPanel>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- D. HR / HRV -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="D.  HR / HRV 心率 &amp; 心率变异性" Style="{StaticResource PanelTitle}"/>
                        <oxy:PlotView Model="{Binding HrHrvModel}" Background="Transparent"/>
                    </DockPanel>
                </Border>

                <!-- F. Trend -->
                <Border Grid.Row="3" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="F.  核心指标全局趋势  — qCON / qNOX / HR" Style="{StaticResource PanelTitle}"/>
                        <oxy:PlotView Model="{Binding TrendModel}" Background="Transparent"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Right: hemodynamics -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="E.  血流动力学 · HR 心率 (bpm)" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Grid.Row="1" Text="{Binding HrText}" Style="{StaticResource BigNumber}" Foreground="{StaticResource AlphaBrush}"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="HRV 心率变异 (ms)" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Grid.Row="1" Text="{Binding HrvText}" Style="{StaticResource BigNumber}" Foreground="{StaticResource AlphaBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Bottom bar: single start button ── -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="16,10" Margin="5,0,5,5" CornerRadius="8">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource StartButton}"
                        Content="{Binding StartButtonText}" Command="{Binding ToggleCommand}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="记录: " Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RecordPathText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Text="{Binding ElapsedText}" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
