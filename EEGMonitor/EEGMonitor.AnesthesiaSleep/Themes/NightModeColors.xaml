<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Night Mode Color Palette — Amber/Red Low-Brightness ═══════════ -->
    <Color x:Key="BgDeepColor">#0A0604</Color>
    <Color x:Key="BgPanelColor">#0E0908</Color>
    <Color x:Key="BgCardColor">#120C0A</Color>
    <Color x:Key="BorderColor">#2A1A12</Color>
    <Color x:Key="TextPrimaryColor">#E8D4B8</Color>
    <Color x:Key="TextSecondaryColor">#6B5040</Color>
    <Color x:Key="AccentCyanColor">#F0A020</Color>
    <Color x:Key="GreenOkColor">#C0A040</Color>
    <Color x:Key="YellowWarnColor">#E08020</Color>
    <Color x:Key="RedCritColor">#D04030</Color>
    <Color x:Key="OrangeColor">#C86020</Color>
    <Color x:Key="AmberColor">#F0A020</Color>

    <!-- Wave colors — adjusted for night visibility -->
    <Color x:Key="DeltaColor">#7B9ED0</Color>
    <Color x:Key="ThetaColor">#D0A040</Color>
    <Color x:Key="AlphaColor">#80C080</Color>
    <Color x:Key="BetaColor">#D08040</Color>
    <Color x:Key="GammaColor">#D06050</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgDeepBrush"       Color="{StaticResource BgDeepColor}"/>
    <SolidColorBrush x:Key="BgPanelBrush"      Color="{StaticResource BgPanelColor}"/>
    <SolidColorBrush x:Key="BgCardBrush"       Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"  Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentCyanBrush"   Color="{StaticResource AccentCyanColor}"/>
    <SolidColorBrush x:Key="GreenOkBrush"      Color="{StaticResource GreenOkColor}"/>
    <SolidColorBrush x:Key="YellowWarnBrush"   Color="{StaticResource YellowWarnColor}"/>
    <SolidColorBrush x:Key="RedCritBrush"      Color="{StaticResource RedCritColor}"/>
    <SolidColorBrush x:Key="OrangeBrush"       Color="{StaticResource OrangeColor}"/>
    <SolidColorBrush x:Key="AmberBrush"        Color="{StaticResource AmberColor}"/>

    <!-- Wave brushes -->
    <SolidColorBrush x:Key="DeltaBrush" Color="{StaticResource DeltaColor}"/>
    <SolidColorBrush x:Key="ThetaBrush" Color="{StaticResource ThetaColor}"/>
    <SolidColorBrush x:Key="AlphaBrush" Color="{StaticResource AlphaColor}"/>
    <SolidColorBrush x:Key="BetaBrush"  Color="{StaticResource BetaColor}"/>
    <SolidColorBrush x:Key="GammaBrush" Color="{StaticResource GammaColor}"/>

</ResourceDictionary>
