<Window x:Class="EEGMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:conv="clr-namespace:EEGMonitor.Views.Converters"
        Title="麻醉深度监测系统"
        Height="900" Width="1600"
        MinHeight="720" MinWidth="1280"
        WindowState="Maximized"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:BISColorConverter x:Key="BISColorConverter"/>
        <conv:NSIColorConverter x:Key="NSIColorConverter"/>
        <conv:NaNToStringConverter x:Key="NaNConv"/>
        <conv:BoolToVisConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisConverter x:Key="InvBoolToVis"/>
    </Window.Resources>

    <DockPanel Background="{StaticResource BgDeepBrush}">

        <!-- ══ HEADER ══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Height="46"
                Background="#040810"
                BorderBrush="#182C46" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Branding + Patient -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="麻醉深度监测系统" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,16,0"/>
                    <Rectangle Width="1" Fill="#182C46" Margin="0,8"/>
                    <TextBlock Text=" " Width="8"/>
                    <TextBlock Text="{Binding PatientId, StringFormat='患者  {0}'}"
                               FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="4,0"/>
                    <TextBlock Text="|" Foreground="#182C46" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SurgeryType, StringFormat='手术室  {0}'}"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Signal warning banner (shown when EMI/electrode issue detected) -->
                <Border Grid.Column="1" Background="#2A0808" BorderBrush="#FF4560" BorderThickness="1"
                        CornerRadius="3" Padding="12,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasSignalWarning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SignalWarning}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#FF4560"/>
                </Border>

                <!-- Center: Live status chips (hidden when warning is showing) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasSignalWarning, Converter={StaticResource InvBoolToVis}}">
                    <!-- SQI chip -->
                    <Border CornerRadius="2" Padding="10,4" Margin="6,0"
                            Background="{Binding IsConnected, Converter={StaticResource BoolToVis},
                                         ConverterParameter='#06200F|#0C1422'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SQI " FontSize="11" Foreground="#3D5A7A" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SqiDisplay}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource GreenOkBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- RE-SE / EMG chip -->
                    <Border CornerRadius="2" Padding="10,4" Margin="6,0" Background="#0C1422">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="EMG (RE-SE) " FontSize="11" Foreground="#3D5A7A" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ReSeDiffDisplay}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Python service -->
                    <Border CornerRadius="2" Padding="10,4" Margin="6,0"
                            Background="{Binding IsServiceOnline, Converter={StaticResource BoolToVis},
                                         ConverterParameter='#062010|#200606'}">
                        <TextBlock FontSize="11">
                            <Run Text="● "/>
                            <Run Text="{Binding IsServiceOnline, Converter={StaticResource BoolToVis},
                                                ConverterParameter='服务在线|服务离线'}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Right: Clock + monitoring status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource GreenOkBrush}" Margin="0,0,6,0"
                             Visibility="{Binding IsSimulating, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding SimulationStatus}" FontSize="11"
                               Foreground="{StaticResource GreenOkBrush}" Margin="0,0,12,0"
                               Visibility="{Binding IsSimulating, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding CurrentTimeDisplay}" FontSize="16" FontWeight="Bold"
                               FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="  " Width="6"/>
                    <TextBlock Text="{Binding CurrentDateDisplay}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ BOTTOM TOOLBAR ════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Height="44"
                Background="#040810"
                BorderBrush="#182C46" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Port + Patient controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Port" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox Style="{StaticResource DarkComboStyle}" ItemsSource="{Binding AvailablePorts}"
                              SelectedItem="{Binding SelectedPort}" Width="72" Height="26" FontSize="10"/>
                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding RefreshPortsCommand}"
                            Content="↻" Margin="3,0" Width="26" Height="26" FontSize="11"/>
                    <ComboBox Style="{StaticResource DarkComboStyle}" ItemsSource="{Binding BaudRates}"
                              SelectedItem="{Binding SelectedBaudRate}" Width="76" Height="26" FontSize="10"/>
                    <!-- Device type selector -->
                    <Rectangle Width="1" Fill="#182C46" Margin="6,4"/>
                    <ComboBox Style="{StaticResource DarkComboStyle}" ItemsSource="{Binding DeviceTypes}"
                              SelectedItem="{Binding SelectedDeviceType}" Width="62" Height="26" FontSize="10"/>
                    <!-- NSM sample rate (visible only when NSM selected) -->
                    <ComboBox Style="{StaticResource DarkComboStyle}" ItemsSource="{Binding NsmSampleRates}"
                              SelectedItem="{Binding NsmSampleRate}" Width="52" Height="26" FontSize="10"
                              Visibility="{Binding NsmSampleRateVisible}"/>
                    <Button Height="26" Width="80" Margin="6,0,0,0" Command="{Binding ConnectCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" FontSize="10">
                        <TextBlock Text="{Binding IsConnected, Converter={StaticResource BoolToVis},
                                   ConverterParameter='断开|连接'}"/>
                    </Button>

                    <Rectangle Width="1" Fill="#182C46" Margin="10,4"/>

                    <!-- Pulse sensor port -->
                    <TextBlock Text="脉搏" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox Style="{StaticResource DarkComboStyle}" ItemsSource="{Binding AvailablePulsePorts}"
                              SelectedItem="{Binding SelectedPulsePort}" Width="72" Height="26" FontSize="10"/>
                    <Button Height="26" Width="66" Margin="4,0,0,0" Command="{Binding PulseConnectCommand}"
                            FontSize="10">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPulseConnected}" Value="True">
                                        <Setter Property="Background" Value="#200606"/>
                                        <Setter Property="BorderBrush" Value="#FF4560"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding IsPulseConnected, Converter={StaticResource BoolToVis},
                                   ConverterParameter='断开|连接'}"/>
                    </Button>

                    <Rectangle Width="1" Fill="#182C46" Margin="10,4"/>

                    <TextBlock Text="Patient" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Height="26" FontSize="10"/>
                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding SurgeryType, UpdateSourceTrigger=PropertyChanged}"
                             Width="90" Height="26" FontSize="10" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Center: Recording timer + EEG diagnostics -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,5,0" Fill="#FF4560"
                             Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding RecordingDuration}" FontSize="13" FontFamily="Consolas"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding EegDiagnostics}" FontSize="10" FontFamily="Consolas"
                               Foreground="#00C8FF" Margin="16,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Right: Action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartRecordingCommand}"
                            Content="● 录制" Height="26" Padding="8,3" FontSize="10" Margin="0,0,4,0"
                            Visibility="{Binding IsRecording, Converter={StaticResource InvBoolToVis}}"/>
                    <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding StopRecordingCommand}"
                            Content="■ 停止" Height="26" Padding="8,3" FontSize="10" Margin="0,0,4,0"
                            Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding OpenPlaybackCommand}"
                            Content="▶ 回放" Height="26" Padding="8,3" FontSize="10" Margin="0,0,4,0"/>
                    <!-- Simulation button -->
                    <Button Command="{Binding OpenSimulationCommand}"
                            Height="26" Padding="8,3" FontSize="10" Margin="0,0,4,0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSimulating}" Value="True">
                                        <Setter Property="Background" Value="#062010"/>
                                        <Setter Property="BorderBrush" Value="#00E676"/>
                                        <Setter Property="Foreground" Value="#00E676"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="⊞ 信号模拟"/>
                    </Button>
                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding OpenSettingsCommand}"
                            Content="⚙" Height="26" Padding="8,3" FontSize="13" Margin="0,0,4,0"/>

                    <!-- Event annotation -->
                    <Rectangle Width="1" Fill="#182C46" Margin="6,4"/>
                    <ComboBox Style="{StaticResource DarkComboStyle}" ItemsSource="{Binding EventTypeOptions}"
                              SelectedItem="{Binding SelectedEventType}" Width="100" Height="26" FontSize="10"/>
                    <TextBox Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding NewEventLabel, UpdateSourceTrigger=PropertyChanged}"
                             Width="130" Height="26" FontSize="10" Margin="4,0"/>
                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding AddEventCommand}"
                            Content="+ 事件" Height="26" Padding="8,3" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ EVENTS TIMELINE ════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Height="56"
                Background="#040810" BorderBrush="#182C46" BorderThickness="0,1,0,0">
            <Grid Margin="8,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="临床事件时间轴" FontSize="9"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ClinicalEvents}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3,0" Padding="6,2" Background="#0C1422"
                                        BorderBrush="#182C46" BorderThickness="1" ToolTip="{Binding Notes}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                   FontSize="8" Foreground="#3D5A7A" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══ F. TREND PANEL — full width ═══════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Height="155"
                Background="#07090F" BorderBrush="#182C46" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Section label -->
                <Border Grid.Column="0" Width="44" Background="#040810"
                        BorderBrush="#182C46" BorderThickness="0,0,1,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="F" FontSize="11" FontWeight="Bold"
                                   Foreground="#3D5A7A" HorizontalAlignment="Center"/>
                        <TextBlock TextAlignment="Center" FontSize="8" Foreground="#3D5A7A" TextWrapping="Wrap" Margin="2,4,2,0">
                            <Run Text="指标"/>
                            <LineBreak/><Run Text="趋势"/>
                            <LineBreak/><Run Text="5min"/>
                        </TextBlock>
                        <TextBlock Text="─" FontSize="8" Foreground="#182C46" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                        <TextBlock Text="─" FontSize="8" Foreground="#00C8FF" HorizontalAlignment="Center"/>
                        <TextBlock Text="BIS" FontSize="7" Foreground="#00C8FF" HorizontalAlignment="Center"/>
                        <TextBlock Text="─ ─" FontSize="8" Foreground="#F0A020" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="SE" FontSize="7" Foreground="#F0A020" HorizontalAlignment="Center"/>
                        <TextBlock Text="·  ·" FontSize="8" Foreground="#FF45A0" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="fNox" FontSize="7" Foreground="#FF45A0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <oxy:PlotView Grid.Column="1" Model="{Binding TrendModel}" Background="Transparent"/>
            </Grid>
        </Border>

        <!-- ══ MAIN CONTENT ═══════════════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22*"/>   <!-- A: Index panel -->
                <ColumnDefinition Width="55*"/>   <!-- B+C+D: Waves -->
                <ColumnDefinition Width="23*"/>   <!-- E: Vitals -->
            </Grid.ColumnDefinitions>

            <!-- ════════════════════════════════════════════════════════════════
                 A. 意识与神经指数
                 ════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>    <!-- BIS / CSI comparison -->
                    <RowDefinition Height="1.4*"/>  <!-- fNox -->
                    <RowDefinition Height="1.1*"/>  <!-- NSM indicators: BS / EMG / NOX -->
                    <RowDefinition Height="2*"/>    <!-- SE / RE -->
                    <RowDefinition Height="1*"/>    <!-- SQI -->
                </Grid.RowDefinitions>

                <!-- Section label A -->
                <Border Grid.Row="0" Style="{StaticResource SectionLabelStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="A" FontSize="10" FontWeight="Bold" Foreground="#3D5A7A" Margin="0,0,6,0"/>
                        <TextBlock Text="意识与神经指数" FontSize="10" Foreground="#3D5A7A"/>
                    </StackPanel>
                </Border>

                <!-- ML BIS vs NSM CSI comparison -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ML BIS card -->
                    <Border Grid.Column="0" Style="{StaticResource IndexCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#060E1C"
                                    BorderBrush="#00C8FF" BorderThickness="0,0,0,1" Padding="8,4">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="BIS" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0"/>
                                        <Border Background="#061220" Padding="4,1" CornerRadius="2">
                                            <TextBlock Text="ML 推理" FontSize="9"
                                                       Foreground="#00C8FF"/>
                                        </Border>
                                        <!-- Sleep/Anesthesia badge -->
                                        <Border Background="{Binding IsSleepDetected, Converter={StaticResource BoolToVis},
                                                         ConverterParameter='#2A1A30|#061220'}"
                                                BorderBrush="{Binding IsSleepDetected, Converter={StaticResource BoolToVis},
                                                             ConverterParameter='#8040FF|#182C46'}"
                                                BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="8,0,0,0"
                                                Visibility="{Binding SaDisplay, Converter={StaticResource BoolToVis},
                                                             ConverterParameter='#|'}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SaIndicator}" FontSize="9" FontWeight="Bold"
                                                           Foreground="#C080FF" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding SaDisplay}" FontSize="8"
                                                           Foreground="#8060A0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="觉醒指数" FontSize="9"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BisDisplay}"
                                           FontSize="56" FontWeight="Bold" FontFamily="Consolas"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding BisValue, Converter={StaticResource BISColorConverter}}"/>
                                <TextBlock Text="{Binding BisZoneDisplay}"
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{Binding BisValue, Converter={StaticResource BISColorConverter}}"/>
                                <TextBlock FontSize="8" HorizontalAlignment="Center" Margin="0,3,0,0"
                                           Foreground="Gray">
                                    <Run Text="0–100  "/><Run Text="40–60" Foreground="#00E676"/><Run Text=" 适宜"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Divider -->
                    <Rectangle Grid.Column="1" Fill="#182C46"/>

                    <!-- NSM CSI card -->
                    <Border Grid.Column="2" Background="#0A1220" BorderBrush="#FF8C00"
                            BorderThickness="2,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#0C101A"
                                    BorderBrush="#FF8C00" BorderThickness="0,0,0,1" Padding="8,4">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="CSI" FontSize="14" FontWeight="Bold"
                                                   Foreground="#FF8C00" Margin="0,0,8,0"/>
                                        <Border Background="#1A1008" Padding="4,1" CornerRadius="2">
                                            <TextBlock Text="NSM 原生" FontSize="9"
                                                       Foreground="#FF8C00"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="麻醉深度指数" FontSize="9"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NsmCsiDisplay}"
                                           FontSize="56" FontWeight="Bold" FontFamily="Consolas"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding NsmCsiValue, Converter={StaticResource BISColorConverter}}"/>
                                <TextBlock Text="{Binding NsmCsiZone}"
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{Binding NsmCsiValue, Converter={StaticResource BISColorConverter}}"/>
                                <TextBlock Text="{Binding NsmStatusDisplay}"
                                           FontSize="8" HorizontalAlignment="Center" Margin="0,3,0,0"
                                           Foreground="Gray"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- fNox card -->
                <Border Grid.Row="2" Background="#0A0A18" BorderBrush="#FF45A0"
                        BorderThickness="2,0,0,0" Margin="0,2,0,2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Header -->
                        <Border Grid.Row="0" Background="#0C0A1A"
                                BorderBrush="#FF45A0" BorderThickness="0,0,0,1" Padding="10,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="fNox" FontSize="12" FontWeight="Bold"
                                               Foreground="#FF45A0" Margin="0,0,8,0"/>
                                    <TextBlock Text="镇痛应激指数" FontSize="9"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- MR mode badge -->
                                <Border Grid.Column="1" Background="#1A0A30" BorderBrush="#8040FF"
                                        BorderThickness="1" CornerRadius="2" Padding="5,1"
                                        Visibility="{Binding FnoxMRMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="MR" FontSize="8" FontWeight="Bold"
                                               Foreground="#8040FF"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="10,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Value + zone -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FnoxDisplay}"
                                           FontSize="44" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{Binding FnoxValue, Converter={StaticResource NSIColorConverter}}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FnoxZoneDisplay}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding FnoxValue, Converter={StaticResource NSIColorConverter}}"/>
                                    <TextBlock FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                                        <Run Text="0–99  "/>
                                        <Run Text="30-50" Foreground="#00E676"/>
                                        <Run Text=" 靶区  "/>
                                        <Run Text="&gt;50" Foreground="#FF4560"/>
                                        <Run Text=" 不足"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <!-- Progress bar -->
                            <ProgressBar Grid.Row="1" Height="5" Margin="0,2,0,0"
                                         Value="{Binding FnoxBarValue}" Minimum="0" Maximum="99"
                                         Foreground="{Binding FnoxValue, Converter={StaticResource NSIColorConverter}}"
                                         Background="#0C1422" BorderThickness="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- NSM device indicators: BS / EMG / NOX -->
                <Grid Grid.Row="3" Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Burst Suppression -->
                    <Border Grid.Column="0" Background="#0A1220" BorderBrush="#FF4560"
                            BorderThickness="1,0,0,0" Margin="0,0,1,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="BS" FontSize="10" FontWeight="Bold"
                                           Foreground="#FF4560" Margin="0,0,4,0"/>
                                <TextBlock Text="爆发抑制" FontSize="8"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding NsmBsDisplay}" FontSize="28" FontWeight="Bold"
                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                       Foreground="{Binding NsmBsValue, Converter={StaticResource NSIColorConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- EMG -->
                    <Border Grid.Column="1" Background="#0A1220" BorderBrush="#F0A020"
                            BorderThickness="1,0,0,0" Margin="0,0,1,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="EMG" FontSize="10" FontWeight="Bold"
                                           Foreground="#F0A020" Margin="0,0,4,0"/>
                                <TextBlock Text="肌电" FontSize="8"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding NsmEmgDisplay}" FontSize="28" FontWeight="Bold"
                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                       Foreground="{Binding NsmEmgValue, Converter={StaticResource NSIColorConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- NOX -->
                    <Border Grid.Column="2" Background="#0A1220" BorderBrush="#FF45A0"
                            BorderThickness="1,0,0,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NOX" FontSize="10" FontWeight="Bold"
                                           Foreground="#FF45A0" Margin="0,0,4,0"/>
                                <TextBlock Text="伤害指数" FontSize="8"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding NsmNoxDisplay}" FontSize="28" FontWeight="Bold"
                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                       Foreground="{Binding NsmNoxValue, Converter={StaticResource NSIColorConverter}}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SE / RE card -->
                <Border Grid.Row="4" Background="#0A1220" BorderBrush="#FF8C00"
                        BorderThickness="2,0,0,0" Margin="0,0,0,2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#0C1220"
                                BorderBrush="#FF8C00" BorderThickness="0,0,0,1" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="熵指数" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource OrangeBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Spectral Entropy" FontSize="9"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- SE -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="SE  状态熵" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SeDisplay}" FontSize="38" FontWeight="Bold"
                                           FontFamily="Consolas" HorizontalAlignment="Center"
                                           Foreground="{Binding SeValue, Converter={StaticResource BISColorConverter}}"/>
                                <TextBlock Text="0 – 91" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Fill="#182C46"/>
                            <!-- RE -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="RE  反应熵" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ReDisplay}" FontSize="38" FontWeight="Bold"
                                           FontFamily="Consolas" HorizontalAlignment="Center"
                                           Foreground="{Binding ReValue, Converter={StaticResource BISColorConverter}}"/>
                                <TextBlock Text="0 – 100" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- SQI card -->
                <Border Grid.Row="5" Background="#0A1220" BorderBrush="#3D5A7A"
                        BorderThickness="2,0,0,0">
                    <Grid Margin="10,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="SQI  信号质量" FontSize="9"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Text="{Binding SqiDisplay}"
                                   FontSize="26" FontWeight="Bold" FontFamily="Consolas"
                                   Foreground="{StaticResource GreenOkBrush}"/>
                        <ProgressBar Grid.Row="2" Height="4" Margin="0,4,0,0"
                                     Value="{Binding SqiValue}" Minimum="0" Maximum="100"
                                     Foreground="{StaticResource GreenOkBrush}" Background="#0C1422" BorderThickness="0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════════
                 B+C+D  EEG Waves + DSA + Pulse
                 ════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- B label -->
                    <RowDefinition Height="5*"/>     <!-- B: wave strips -->
                    <RowDefinition Height="Auto"/>   <!-- C label -->
                    <RowDefinition Height="2.5*"/>   <!-- C: DSA -->
                    <RowDefinition Height="Auto"/>   <!-- D label -->
                    <RowDefinition Height="1.2*"/>   <!-- D: Pulse -->
                </Grid.RowDefinitions>

                <!-- B Section label -->
                <Border Grid.Row="0" Style="{StaticResource SectionLabelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="B" FontSize="10" FontWeight="Bold" Foreground="#3D5A7A" Margin="0,0,6,0"/>
                            <TextBlock Text="EEG 脑电频段分解（波形后 5 频段）" FontSize="10" Foreground="#3D5A7A"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="10 s / div" FontSize="9"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>

                <!-- B: 6 Wave strips (RAW + γ β α θ δ) -->
                <Border Grid.Row="1" Background="#07090F" BorderBrush="#182C46" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>  <!-- label col -->
                            <ColumnDefinition Width="*"/>   <!-- plot col -->
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.3*"/> <!-- RAW — taller for prominence -->
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Label: RAW -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#060C14"
                                BorderBrush="#182C46" BorderThickness="0,0,1,1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="EEG" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="原始" FontSize="7"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="CH1" FontSize="6"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Label: γ -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#060C14"
                                BorderBrush="#182C46" BorderThickness="0,0,1,1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="γ" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource GammaBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="&gt;30Hz" FontSize="7"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Label: β -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#060C14"
                                BorderBrush="#182C46" BorderThickness="0,0,1,1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="β" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource BetaBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="13-30Hz" FontSize="7"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Label: α -->
                        <Border Grid.Row="3" Grid.Column="0" Background="#060C14"
                                BorderBrush="#182C46" BorderThickness="0,0,1,1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="α" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource AlphaBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="8-13Hz" FontSize="7"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Label: θ -->
                        <Border Grid.Row="4" Grid.Column="0" Background="#060C14"
                                BorderBrush="#182C46" BorderThickness="0,0,1,1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="θ" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource ThetaBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="4-7Hz" FontSize="7"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Label: δ -->
                        <Border Grid.Row="5" Grid.Column="0" Background="#060C14"
                                BorderBrush="#182C46" BorderThickness="0,0,1,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="δ" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource DeltaBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="0.5-4Hz" FontSize="7"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Plots: top-to-bottom = RAW γ β α θ δ -->
                        <oxy:PlotView Grid.Row="0" Grid.Column="1" Model="{Binding RawEEGModel}"
                                      Background="Transparent" Margin="0,0,0,1"/>
                        <oxy:PlotView Grid.Row="1" Grid.Column="1" Model="{Binding GammaModel}"
                                      Background="Transparent" Margin="0,0,0,1"/>
                        <oxy:PlotView Grid.Row="2" Grid.Column="1" Model="{Binding BetaModel}"
                                      Background="Transparent" Margin="0,0,0,1"/>
                        <oxy:PlotView Grid.Row="3" Grid.Column="1" Model="{Binding AlphaModel}"
                                      Background="Transparent" Margin="0,0,0,1"/>
                        <oxy:PlotView Grid.Row="4" Grid.Column="1" Model="{Binding ThetaModel}"
                                      Background="Transparent" Margin="0,0,0,1"/>
                        <oxy:PlotView Grid.Row="5" Grid.Column="1" Model="{Binding DeltaModel}"
                                      Background="Transparent"/>
                    </Grid>
                </Border>

                <!-- C Section label -->
                <Border Grid.Row="2" Style="{StaticResource SectionLabelStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="C" FontSize="10" FontWeight="Bold" Foreground="#3D5A7A" Margin="0,0,6,0"/>
                        <TextBlock Text="脑电频段能量随时占比（DSA）— δ / θ / α / β / γ" FontSize="10" Foreground="#3D5A7A"/>
                    </StackPanel>
                </Border>

                <!-- C: DSA + band % text -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="68"/>
                    </Grid.ColumnDefinitions>
                    <oxy:PlotView Grid.Column="0" Model="{Binding DsaModel}" Background="Transparent"/>
                    <!-- Band power percentages -->
                    <Border Grid.Column="1" Background="#060C14" BorderBrush="#182C46" BorderThickness="1,0,0,0"
                            Padding="6,8">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="γ" FontSize="10" Foreground="{StaticResource GammaBrush}"/>
                                <TextBlock FontSize="16" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{StaticResource GammaBrush}">
                                    <Run Text="{Binding GammaPower, StringFormat=F1}"/><Run Text="%"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="β" FontSize="10" Foreground="{StaticResource BetaBrush}"/>
                                <TextBlock FontSize="16" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{StaticResource BetaBrush}">
                                    <Run Text="{Binding BetaPower, StringFormat=F1}"/><Run Text="%"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="α" FontSize="10" Foreground="{StaticResource AlphaBrush}"/>
                                <TextBlock FontSize="16" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{StaticResource AlphaBrush}">
                                    <Run Text="{Binding AlphaPower, StringFormat=F1}"/><Run Text="%"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="θ" FontSize="10" Foreground="{StaticResource ThetaBrush}"/>
                                <TextBlock FontSize="16" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{StaticResource ThetaBrush}">
                                    <Run Text="{Binding ThetaPower, StringFormat=F1}"/><Run Text="%"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="δ" FontSize="10" Foreground="{StaticResource DeltaBrush}"/>
                                <TextBlock FontSize="16" FontWeight="Bold" FontFamily="Consolas"
                                           Foreground="{StaticResource DeltaBrush}">
                                    <Run Text="{Binding DeltaPower, StringFormat=F1}"/><Run Text="%"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- D Section label -->
                <Border Grid.Row="4" Style="{StaticResource SectionLabelStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="D" FontSize="10" FontWeight="Bold" Foreground="#3D5A7A" Margin="0,0,6,0"/>
                        <TextBlock Text="脉搏 / PPG 波形" FontSize="10" Foreground="#3D5A7A"/>
                    </StackPanel>
                </Border>

                <!-- D: Pulse wave -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#060C14" BorderBrush="#182C46" BorderThickness="0,0,1,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="PPG" FontSize="9" FontWeight="Bold"
                                       Foreground="#FF4560" HorizontalAlignment="Center"/>
                            <TextBlock Text="脉搏" FontSize="7"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <oxy:PlotView Grid.Column="1" Model="{Binding PulseWaveModel}" Background="Transparent"/>
                </Grid>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════════
                 E. 血流动力学与生命体征
                 ════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.4*"/>   <!-- HR -->
                    <RowDefinition Height="1*"/>     <!-- SpO2 -->
                    <RowDefinition Height="1*"/>     <!-- HRV -->
                    <RowDefinition Height="Auto"/>   <!-- Band power section label -->
                    <RowDefinition Height="2.5*"/>   <!-- Band powers (dual ML/NSM) -->
                </Grid.RowDefinitions>

                <!-- E Section label -->
                <Border Grid.Row="0" Style="{StaticResource SectionLabelStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="E" FontSize="10" FontWeight="Bold" Foreground="#3D5A7A" Margin="0,0,6,0"/>
                        <TextBlock Text="血流动力学与氧合" FontSize="10" Foreground="#3D5A7A"/>
                    </StackPanel>
                </Border>

                <!-- PR Heart Rate -->
                <Border Grid.Row="1" Background="#0A1220" BorderBrush="#00C8FF"
                        BorderThickness="0,0,0,1" Padding="12,6">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PR  脉率" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HeartRateDisplay}" FontSize="52" FontWeight="Bold"
                                       FontFamily="Consolas" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="bpm" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SpO2 -->
                <Border Grid.Row="2" Background="#0A1220" BorderBrush="#182C46"
                        BorderThickness="0,0,0,1" Padding="12,6">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SpO₂  血氧饱和度" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SpO2Display}" FontSize="40" FontWeight="Bold"
                                       FontFamily="Consolas" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Bottom" Margin="4,0,0,6"
                                       Visibility="{Binding SpO2Display, Converter={StaticResource BoolToVis},
                                                    ConverterParameter='---|}'}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- HRV -->
                <Border Grid.Row="3" Background="#0A1220" BorderBrush="#182C46"
                        BorderThickness="0,0,0,1" Padding="12,6">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HRV  心率变异" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HrvDisplay}" FontSize="40" FontWeight="Bold"
                                       FontFamily="Consolas" Foreground="{StaticResource GreenOkBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Band power section label -->
                <Border Grid.Row="4" Style="{StaticResource SectionLabelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="频带功率占比" FontSize="10" Foreground="#3D5A7A"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                            <TextBlock Text="ML " FontSize="8" Foreground="#00C8FF" VerticalAlignment="Center"/>
                            <TextBlock Text="/" FontSize="8" Foreground="#3D5A7A" VerticalAlignment="Center"/>
                            <TextBlock Text=" NSM" FontSize="8" Foreground="#FF8C00" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Band power bars: dual ML / NSM per band -->
                <Border Grid.Row="5" Background="#0A1220" Padding="4,2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- γ: top=ML, bottom=NSM -->
                        <Grid Grid.Row="0" Margin="0,1">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Text="γ" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource GammaBrush}" VerticalAlignment="Center"/>
                            <!-- ML -->
                            <ProgressBar Grid.Row="0" Grid.Column="1" Height="5" Margin="2,1,2,0"
                                         Value="{Binding GammaPower}" Minimum="0" Maximum="100"
                                         Foreground="#00C8FF" Background="#0C1422" BorderThickness="0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" FontSize="7" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="#00C8FF"
                                       Text="{Binding GammaPower, StringFormat=F1}"/>
                            <!-- NSM -->
                            <ProgressBar Grid.Row="1" Grid.Column="1" Height="5" Margin="2,0,2,1"
                                         Value="{Binding NsmGammaPower}" Minimum="0" Maximum="100"
                                         Foreground="{StaticResource GammaBrush}" Background="#0C1422" BorderThickness="0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" FontSize="7" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource GammaBrush}"
                                       Text="{Binding NsmGammaPower, StringFormat=F1}"/>
                        </Grid>
                        <!-- β -->
                        <Grid Grid.Row="1" Margin="0,1">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Text="β" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource BetaBrush}" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Row="0" Grid.Column="1" Height="5" Margin="2,1,2,0"
                                         Value="{Binding BetaPower}" Minimum="0" Maximum="100"
                                         Foreground="#00C8FF" Background="#0C1422" BorderThickness="0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" FontSize="7" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="#00C8FF"
                                       Text="{Binding BetaPower, StringFormat=F1}"/>
                            <ProgressBar Grid.Row="1" Grid.Column="1" Height="5" Margin="2,0,2,1"
                                         Value="{Binding NsmBetaPower}" Minimum="0" Maximum="100"
                                         Foreground="{StaticResource BetaBrush}" Background="#0C1422" BorderThickness="0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" FontSize="7" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource BetaBrush}"
                                       Text="{Binding NsmBetaPower, StringFormat=F1}"/>
                        </Grid>
                        <!-- α -->
                        <Grid Grid.Row="2" Margin="0,1">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Text="α" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AlphaBrush}" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Row="0" Grid.Column="1" Height="5" Margin="2,1,2,0"
                                         Value="{Binding AlphaPower}" Minimum="0" Maximum="100"
                                         Foreground="#00C8FF" Background="#0C1422" BorderThickness="0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" FontSize="7" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="#00C8FF"
                                       Text="{Binding AlphaPower, StringFormat=F1}"/>
                            <ProgressBar Grid.Row="1" Grid.Column="1" Height="5" Margin="2,0,2,1"
                                         Value="{Binding NsmAlphaPower}" Minimum="0" Maximum="100"
                                         Foreground="{StaticResource AlphaBrush}" Background="#0C1422" BorderThickness="0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" FontSize="7" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource AlphaBrush}"
                                       Text="{Binding NsmAlphaPower, StringFormat=F1}"/>
                        </Grid>
                        <!-- θ -->
                        <Grid Grid.Row="3" Margin="0,1">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Text="θ" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource ThetaBrush}" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Row="0" Grid.Column="1" Height="5" Margin="2,1,2,0"
                                         Value="{Binding ThetaPower}" Minimum="0" Maximum="100"
                                         Foreground="#00C8FF" Background="#0C1422" BorderThickness="0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" FontSize="7" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="#00C8FF"
                                       Text="{Binding ThetaPower, StringFormat=F1}"/>
                            <ProgressBar Grid.Row="1" Grid.Column="1" Height="5" Margin="2,0,2,1"
                                         Value="{Binding NsmThetaPower}" Minimum="0" Maximum="100"
                                         Foreground="{StaticResource ThetaBrush}" Background="#0C1422" BorderThickness="0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" FontSize="7" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource ThetaBrush}"
                                       Text="{Binding NsmThetaPower, StringFormat=F1}"/>
                        </Grid>
                        <!-- δ -->
                        <Grid Grid.Row="4" Margin="0,1">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Text="δ" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource DeltaBrush}" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Row="0" Grid.Column="1" Height="5" Margin="2,1,2,0"
                                         Value="{Binding DeltaPower}" Minimum="0" Maximum="100"
                                         Foreground="#00C8FF" Background="#0C1422" BorderThickness="0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" FontSize="7" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="#00C8FF"
                                       Text="{Binding DeltaPower, StringFormat=F1}"/>
                            <ProgressBar Grid.Row="1" Grid.Column="1" Height="5" Margin="2,0,2,1"
                                         Value="{Binding NsmDeltaPower}" Minimum="0" Maximum="100"
                                         Foreground="{StaticResource DeltaBrush}" Background="#0C1422" BorderThickness="0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" FontSize="7" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Foreground="{StaticResource DeltaBrush}"
                                       Text="{Binding NsmDeltaPower, StringFormat=F1}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
