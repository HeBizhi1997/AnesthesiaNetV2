<UserControl x:Class="EEGMonitor.AnesthesiaSleep.Views.Controls.SleepStatisticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgPanelBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 摘要卡片 -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                <Border Style="{StaticResource CardBorderStyle}" Width="180" Height="90" Margin="4">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="总睡眠时间" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TstMinutes, StringFormat={}{0:F0} min}" FontSize="22"
                                   FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Width="180" Height="90" Margin="4">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="睡眠效率" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding SePercent, StringFormat={}{0:F0}%}" FontSize="22"
                                   FontWeight="Bold" Foreground="{StaticResource GreenOkBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Width="180" Height="90" Margin="4">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="入睡潜伏期" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding SolMinutes, StringFormat={}{0:F0} min}" FontSize="22"
                                   FontWeight="Bold" Foreground="{StaticResource AmberBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Width="180" Height="90" Margin="4">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="入睡后清醒" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding WasoMinutes, StringFormat={}{0:F0} min}" FontSize="22"
                                   FontWeight="Bold" Foreground="{StaticResource RedCritBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Width="180" Height="90" Margin="4">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="REM 潜伏期" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding RemLatencyMinutes, StringFormat={}{0:F0} min}" FontSize="22"
                                   FontWeight="Bold" Foreground="#E040C0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Width="180" Height="90" Margin="4">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="觉醒指数" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ArousalIndex, StringFormat={}{0:F1}/hr}" FontSize="22"
                                   FontWeight="Bold" Foreground="{StaticResource OrangeBrush}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- 分期分布 -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="睡眠结构分布" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,10"/>

                    <!-- 堆叠条 -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F0A020" CornerRadius="2,0,0,2" MinWidth="4"
                                ToolTip="{Binding N1Percent, StringFormat='N1: {0:F0}%'}"/>
                        <Border Grid.Column="1" Background="{StaticResource AccentCyanBrush}" MinWidth="4"
                                ToolTip="{Binding N2Percent, StringFormat='N2: {0:F0}%'}"/>
                        <Border Grid.Column="2" Background="{StaticResource DeltaBrush}" MinWidth="4"
                                ToolTip="{Binding N3Percent, StringFormat='N3: {0:F0}%'}"/>
                        <Border Grid.Column="3" Background="#E040C0" CornerRadius="0,2,2,0" MinWidth="4"
                                ToolTip="{Binding RemPercent, StringFormat='REM: {0:F0}%'}"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Rectangle Width="12" Height="12" Fill="#F0A020" Margin="0,0,4,0"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextPrimaryBrush}">
                                <Run Text="N1: "/><Run Text="{Binding N1Percent, StringFormat={}{0:F0}%}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Rectangle Width="12" Height="12" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,4,0"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextPrimaryBrush}">
                                <Run Text="N2: "/><Run Text="{Binding N2Percent, StringFormat={}{0:F0}%}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Rectangle Width="12" Height="12" Fill="{StaticResource DeltaBrush}" Margin="0,0,4,0"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextPrimaryBrush}">
                                <Run Text="N3: "/><Run Text="{Binding N3Percent, StringFormat={}{0:F0}%}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Rectangle Width="12" Height="12" Fill="#E040C0" Margin="0,0,4,0"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextPrimaryBrush}">
                                <Run Text="REM: "/><Run Text="{Binding RemPercent, StringFormat={}{0:F0}%}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 记录信息 -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0">
                        <Run Text="记录时长: "/>
                        <Run Text="{Binding RecordingDurationMinutes, StringFormat={}{0:F0} min}"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0">
                        <Run Text="总 Epoch 数: "/>
                        <Run Text="{Binding TotalEpochs}" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="伪迹 Epoch: "/>
                        <Run Text="{Binding ArtifactEpochs}" Foreground="{StaticResource RedCritBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
