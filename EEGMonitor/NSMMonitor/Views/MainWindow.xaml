<Window x:Class="NSMMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:ctrl="clr-namespace:NSMMonitor.Controls"
        Title="NSM 麻醉深度监护系统" Height="880" Width="1520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei, Segoe UI">

    <DockPanel>

        <!-- ═══════════ 顶部标题栏 ═══════════ -->
        <Border DockPanel.Dock="Top" Height="66" Background="#0C1424"
                BorderBrush="#1E2A44" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <!-- 标题 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NSM" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="麻醉深度监护系统" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TitleBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="Anesthesia Depth Monitoring" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Bottom" Margin="12,0,0,5"/>
                </StackPanel>

                <!-- 状态图标芯片 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="18" Padding="14,5"
                        Background="#14203A" BorderBrush="#243450" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE701;" Style="{StaticResource StatusGlyphStyle}"/>
                        <TextBlock Text="&#xE714;" Style="{StaticResource StatusGlyphStyle}"/>
                        <TextBlock Text="&#xE720;" Style="{StaticResource StatusGlyphStyle}"/>
                        <TextBlock Text="&#xE774;" Style="{StaticResource StatusGlyphStyle}"/>
                        <Border CornerRadius="10" Padding="7,2" Margin="6,0,0,0" Background="#0E3326">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" Foreground="{StaticResource GreenOkBrush}"
                                       Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 右侧：数据源 + 时间 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="数据源" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border CornerRadius="13" Padding="12,4" Margin="0,0,16,0" Background="#14203A" BorderBrush="#243450" BorderThickness="1">
                        <TextBlock Text="{Binding SourceName}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentTime}" FontSize="23" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ 底部工具栏 ═══════════ -->
        <Border DockPanel.Dock="Bottom" Background="#0C1424" BorderBrush="#1E2A44" BorderThickness="0,1,0,0">
            <Grid Margin="18,9">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="数据源" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="124" Style="{StaticResource DarkComboStyle}" VerticalAlignment="Center"
                              ItemsSource="{Binding SourceModes}"
                              SelectedValuePath="Mode" SelectedValue="{Binding SelectedSourceMode}"
                              IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}" Margin="0,0,12,0"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVis}}">
                        <ComboBox Width="100" Style="{StaticResource DarkComboStyle}" VerticalAlignment="Center"
                                  ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"/>
                        <Button Content="刷新" Command="{Binding RefreshPortsCommand}" Style="{StaticResource ActionButtonStyle}" Margin="6,0,12,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsPlaybackMode, Converter={StaticResource BoolToVis}}">
                        <Button Content="选择文件…" Command="{Binding BrowsePlaybackFileCommand}" Style="{StaticResource ActionButtonStyle}"
                                IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Text="{Binding PlaybackFileDisplay}" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" FontSize="12" Margin="8,0,12,0" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Command="{Binding ToggleConnectionCommand}" Width="100">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Content" Value="连接"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Content" Value="断开"/>
                                        <Setter Property="Background" Value="#33121A"/>
                                        <Setter Property="BorderBrush" Value="#FB5C6E"/>
                                        <Setter Property="Foreground" Value="#FB5C6E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Rectangle Width="1" Height="22" Fill="#243450" Margin="14,0"/>

                    <Button Command="{Binding ToggleRecordingCommand}" Width="104" IsEnabled="{Binding IsConnected}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                <Setter Property="Content" Value="● 录制"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Content" Value="■ 停止录制"/>
                                        <Setter Property="Background" Value="#33121A"/>
                                        <Setter Property="BorderBrush" Value="#FB5C6E"/>
                                        <Setter Property="Foreground" Value="#FB5C6E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding RecordingStatus}" Foreground="{StaticResource RedCritBrush}" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Text="采样率 " Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SampleRate, StringFormat={}{0} Hz}" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ 主显示区 ═══════════ -->
        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26*"/>
                <ColumnDefinition Width="44*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────── 左列 ─────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.3*"/>
                    <RowDefinition Height="1.55*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- CSI -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CSI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="麻醉深度指数 (等效 BIS)" Style="{StaticResource CardTitleStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ctrl:RingGauge Grid.Row="1" Margin="0,8" Value="{Binding CsiValue}" Maximum="100"
                                        RingThickness="16" TrackBrush="{StaticResource GaugeTrackBrush}"
                                        ProgressBrush="{StaticResource CsiGaugeBrush}" GlowColor="#A855F7">
                            <ctrl:RingGauge.CenterContent>
                                <StackPanel>
                                    <TextBlock Text="{Binding CsiDisplay}" FontSize="58" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{Binding CsiValue, Converter={StaticResource CsiColor}}"/>
                                    <TextBlock Text="{Binding CsiZone}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-4,0,0"
                                               Foreground="{Binding CsiValue, Converter={StaticResource CsiColor}}"/>
                                </StackPanel>
                            </ctrl:RingGauge.CenterContent>
                        </ctrl:RingGauge>

                        <Grid Grid.Row="2" Height="22" Margin="0,4,0,0">
                            <Border CornerRadius="11" Background="{StaticResource CsiGaugeBrush}" Opacity="0.85"/>
                            <TextBlock Text="适宜手术区间  40–60" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- NOX -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NOX" FontSize="14" FontWeight="Bold" Foreground="#34D399"/>
                            <TextBlock Text="伤害感受 / 镇痛指数" Style="{StaticResource CardTitleStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ctrl:RingGauge Grid.Row="1" Margin="0,6" Value="{Binding NoxValue}" Maximum="100"
                                        RingThickness="13" TrackBrush="{StaticResource GaugeTrackBrush}"
                                        ProgressBrush="{StaticResource NoxGaugeBrush}" GlowColor="#2DD4BF">
                            <ctrl:RingGauge.CenterContent>
                                <StackPanel>
                                    <TextBlock Text="{Binding NoxDisplay}" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{Binding NoxValue, Converter={StaticResource NoxColor}}"/>
                                    <TextBlock Text="{Binding NoxZone}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-2,0,0"
                                               Foreground="{Binding NoxValue, Converter={StaticResource NoxColor}}"/>
                                </StackPanel>
                            </ctrl:RingGauge.CenterContent>
                        </ctrl:RingGauge>
                    </Grid>
                </Border>

                <!-- BS / SQI / EMG -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid Margin="6,8">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ctrl:RingGauge Value="{Binding BsValue}" Maximum="100" RingThickness="7"
                                            TrackBrush="{StaticResource GaugeTrackBrush}" ProgressBrush="{StaticResource CyanGaugeBrush}" GlowColor="#22D3EE">
                                <ctrl:RingGauge.CenterContent>
                                    <TextBlock Text="{Binding BsDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </ctrl:RingGauge.CenterContent>
                            </ctrl:RingGauge>
                            <TextBlock Grid.Row="1" Text="BS 爆发抑制" Style="{StaticResource MiniLabelStyle}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <Grid Margin="6,8">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ctrl:RingGauge Value="{Binding SqiValue}" Maximum="100" RingThickness="7"
                                            TrackBrush="{StaticResource GaugeTrackBrush}" ProgressBrush="{StaticResource NoxGaugeBrush}" GlowColor="#34D399">
                                <ctrl:RingGauge.CenterContent>
                                    <TextBlock Text="{Binding SqiDisplay}" FontSize="20" FontWeight="Bold"
                                               Foreground="{Binding SqiValue, Converter={StaticResource SqiColor}}"/>
                                </ctrl:RingGauge.CenterContent>
                            </ctrl:RingGauge>
                            <TextBlock Grid.Row="1" Text="SQI 信号质量" Style="{StaticResource MiniLabelStyle}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid Margin="6,8">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ctrl:RingGauge Value="{Binding EmgValue}" Maximum="100" RingThickness="7"
                                            TrackBrush="{StaticResource GaugeTrackBrush}" ProgressBrush="{StaticResource BlueGaugeBrush}" GlowColor="#5B8EFF">
                                <ctrl:RingGauge.CenterContent>
                                    <TextBlock Text="{Binding EmgDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </ctrl:RingGauge.CenterContent>
                            </ctrl:RingGauge>
                            <TextBlock Grid.Row="1" Text="EMG 肌电" Style="{StaticResource MiniLabelStyle}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ─────────── 中列 ─────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.05*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid Margin="14,12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="EEG 原始波形" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="±127 µV" Style="{StaticResource CardTitleStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <oxy:PlotView Grid.Row="1" Model="{Binding EegModel}" Background="Transparent" Margin="0,6,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid Margin="14,12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="趋势 — CSI / NOX / SEF95 (近 5 分钟)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                        <oxy:PlotView Grid.Row="1" Model="{Binding TrendModel}" Background="Transparent" Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <!-- 无数据占位（脉冲动画） -->
                <Border Grid.Row="0" Grid.RowSpan="2" Background="#D40A0E1A" CornerRadius="14" Margin="6"
                        Visibility="{Binding HasData, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="140" Height="140" HorizontalAlignment="Center">
                            <Ellipse x:Name="PulseRing" Width="140" Height="140" Stroke="{StaticResource AccentCyanBrush}"
                                     StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Opacity="0.6">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="PulseRing2" Width="140" Height="140" Stroke="{StaticResource AccentCyanBrush}"
                                     StrokeThickness="2" RenderTransformOrigin="0.5,0.5" Opacity="0.6">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="18" Height="18" Fill="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding EmptyHint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                    </StackPanel>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.35" To="1.4" Duration="0:0:1.8"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.35" To="1.4" Duration="0:0:1.8"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:1.8"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.35" To="1.4" BeginTime="0:0:0.9" Duration="0:0:1.8"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.35" To="1.4" BeginTime="0:0:0.9" Duration="0:0:1.8"/>
                                    <DoubleAnimation Storyboard.TargetName="PulseRing2" Storyboard.TargetProperty="Opacity" From="0.7" To="0" BeginTime="0:0:0.9" Duration="0:0:1.8"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>

            <!-- ─────────── 右列 ─────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 频带功率 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel Margin="16,12">
                        <TextBlock Text="频带功率 (dB)  Frequency Power" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,10"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                            <TextBlock Text="δ Delta" Foreground="{StaticResource DeltaTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="14" CornerRadius="7" Background="#0E1626" ClipToBounds="True" VerticalAlignment="Center" Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding DeltaPower, Converter={StaticResource DbBar}, ConverterParameter=fill}"/>
                                        <ColumnDefinition Width="{Binding DeltaPower, Converter={StaticResource DbBar}, ConverterParameter=rest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="7" Background="{StaticResource DeltaBarBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding DeltaPower, StringFormat={}{0:0.0} dB}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                            <TextBlock Text="θ Theta" Foreground="{StaticResource ThetaTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="14" CornerRadius="7" Background="#0E1626" ClipToBounds="True" VerticalAlignment="Center" Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ThetaPower, Converter={StaticResource DbBar}, ConverterParameter=fill}"/>
                                        <ColumnDefinition Width="{Binding ThetaPower, Converter={StaticResource DbBar}, ConverterParameter=rest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="7" Background="{StaticResource ThetaBarBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding ThetaPower, StringFormat={}{0:0.0} dB}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                            <TextBlock Text="α Alpha" Foreground="{StaticResource AlphaTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="14" CornerRadius="7" Background="#0E1626" ClipToBounds="True" VerticalAlignment="Center" Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding AlphaPower, Converter={StaticResource DbBar}, ConverterParameter=fill}"/>
                                        <ColumnDefinition Width="{Binding AlphaPower, Converter={StaticResource DbBar}, ConverterParameter=rest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="7" Background="{StaticResource AlphaBarBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding AlphaPower, StringFormat={}{0:0.0} dB}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                            <TextBlock Text="β Beta" Foreground="{StaticResource BetaTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="14" CornerRadius="7" Background="#0E1626" ClipToBounds="True" VerticalAlignment="Center" Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding BetaPower, Converter={StaticResource DbBar}, ConverterParameter=fill}"/>
                                        <ColumnDefinition Width="{Binding BetaPower, Converter={StaticResource DbBar}, ConverterParameter=rest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="7" Background="{StaticResource BetaBarBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding BetaPower, StringFormat={}{0:0.0} dB}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                            <TextBlock Text="γ Gamma" Foreground="{StaticResource GammaTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="14" CornerRadius="7" Background="#0E1626" ClipToBounds="True" VerticalAlignment="Center" Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding GammaPower, Converter={StaticResource DbBar}, ConverterParameter=fill}"/>
                                        <ColumnDefinition Width="{Binding GammaPower, Converter={StaticResource DbBar}, ConverterParameter=rest}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="7" Background="{StaticResource GammaBarBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding GammaPower, StringFormat={}{0:0.0} dB}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2×2 仪表 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Height="150">
                        <Grid Margin="6,8">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ctrl:RingGauge Value="{Binding Sef95Value}" Maximum="44" RingThickness="9"
                                            TrackBrush="{StaticResource GaugeTrackBrush}" ProgressBrush="{StaticResource GoldGaugeBrush}" GlowColor="#F5C242">
                                <ctrl:RingGauge.CenterContent>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Sef95Value, StringFormat={}{0:0}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Hz" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,-3,0,0"/>
                                    </StackPanel>
                                </ctrl:RingGauge.CenterContent>
                            </ctrl:RingGauge>
                            <TextBlock Grid.Row="1" Text="SEF95 谱边缘" Style="{StaticResource MiniLabelStyle}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Height="150">
                        <Grid Margin="6,8">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ctrl:RingGauge Value="{Binding EogValue}" Maximum="100" RingThickness="9"
                                            TrackBrush="{StaticResource GaugeTrackBrush}" ProgressBrush="{StaticResource CyanGaugeBrush}" GlowColor="#22D3EE">
                                <ctrl:RingGauge.CenterContent>
                                    <TextBlock Text="{Binding EogDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </ctrl:RingGauge.CenterContent>
                            </ctrl:RingGauge>
                            <TextBlock Grid.Row="1" Text="EOG 眼动" Style="{StaticResource MiniLabelStyle}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Height="150">
                        <Grid Margin="6,8">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ctrl:RingGauge Value="{Binding BlackImpedanceValue}" Maximum="10" RingThickness="9"
                                            TrackBrush="{StaticResource GaugeTrackBrush}" ProgressBrush="{StaticResource BlueGaugeBrush}" GlowColor="#5B8EFF">
                                <ctrl:RingGauge.CenterContent>
                                    <TextBlock Text="{Binding BlackImpedanceDisplay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </ctrl:RingGauge.CenterContent>
                            </ctrl:RingGauge>
                            <TextBlock Grid.Row="1" Text="黑电极阻抗" Style="{StaticResource MiniLabelStyle}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Height="150">
                        <Grid Margin="6,8">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ctrl:RingGauge Value="{Binding WhiteImpedanceValue}" Maximum="10" RingThickness="9"
                                            TrackBrush="{StaticResource GaugeTrackBrush}" ProgressBrush="{StaticResource CyanGaugeBrush}" GlowColor="#22D3EE">
                                <ctrl:RingGauge.CenterContent>
                                    <TextBlock Text="{Binding WhiteImpedanceDisplay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </ctrl:RingGauge.CenterContent>
                            </ctrl:RingGauge>
                            <TextBlock Grid.Row="1" Text="白电极阻抗" Style="{StaticResource MiniLabelStyle}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 临床事件 + 手动标注 -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid Margin="14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="临床事件" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="Clinical Events" Style="{StaticResource CardTitleStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,10,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Width="96" Style="{StaticResource DarkComboStyle}" VerticalAlignment="Center"
                                      ItemsSource="{Binding EventTypes}"
                                      SelectedValuePath="Type" SelectedValue="{Binding SelectedAnnotationType}"/>
                            <TextBox Grid.Column="1" Margin="6,0" VerticalContentAlignment="Center" Height="30"
                                     Background="#152138" Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="#2A3A5A" CaretBrush="{StaticResource TextPrimaryBrush}"
                                     Text="{Binding AnnotationNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="备注（可选）"/>
                            <Button Grid.Column="2" Content="标注" Width="58" Command="{Binding AddAnnotationCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#14203A" CornerRadius="8" Padding="12,8" Margin="0,3"
                                                BorderBrush="{Binding Accent}" BorderThickness="3,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Time}" Foreground="{Binding Accent}" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CsiText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
